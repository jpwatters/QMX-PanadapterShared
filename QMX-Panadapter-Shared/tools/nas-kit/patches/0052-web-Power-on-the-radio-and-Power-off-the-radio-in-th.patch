+  /* Power the QMX itself on and off - the same as the drawer's two rows.
+     On goes to the NAS relay (Remote Power-ON); off is PS0; after RX;. */
+  { const on = document.getElementById("radio-on-link");
+    if (on) on.addEventListener("click", async function (e) {
+      e.preventDefault();
+      const prev = on.textContent;
+      on.textContent = "Asking the NAS …";
+      try {
+        const r = await fetch("/api/cmd", {
+          method: "POST", headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ action: "radio_power_on" })
+        });
+        const j = await r.json().catch(() => ({}));
+        alert(j.message || ("The device answered HTTP " + r.status));
+      } catch (err) {
+        alert("No answer from the Tab5.");
+      } finally {
+        on.textContent = prev;
+      }
+    }); }
+  { const off = document.getElementById("radio-off-link");
+    if (off) off.addEventListener("click", async function (e) {
+      e.preventDefault();
+      if (!confirm("Power the radio (QMX) off?\n\n" +
+                   "• The radio is put back into receive first.\n" +
+                   "• It does NOT come back on by itself - use Power on the radio " +
+                   "(NAS with the FTDI cable) or the QMX's VOL knob.\n" +
+                   "• Over the NAS the relay needs its allow-ps0 flag file.")) return;
+      const prev = off.textContent;
+      off.textContent = "Powering the radio off …";
+      try {
+        const r = await fetch("/api/cmd", {
+          method: "POST", headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ action: "radio_power_off", confirm: "RADIOOFF" })
+        });
+        const j = await r.json().catch(() => ({}));
+        alert(j.message || ("The device answered HTTP " + r.status));
+      } catch (err) {
+        alert("No answer from the Tab5.");
+      } finally {
+        off.textContent = prev;
+      }
+    }); }
+
   wireReset("reset-settings-link", "reset_settings",
     "Reset ALL app settings and memory channels to defaults?\n\n" +
     "• KEEPS your QSO log (ADIF) and WiFi.\n" +
