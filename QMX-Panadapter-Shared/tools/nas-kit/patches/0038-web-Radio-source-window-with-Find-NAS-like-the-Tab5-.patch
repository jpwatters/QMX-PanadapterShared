+const relayEsc = (t) => String(t).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
+
+async function relayRefresh() {
+  const cur = document.getElementById("relay-cur");
+  let d = null;
+  try { d = await (await fetch("/api/relay", { cache: "no-store" })).json(); } catch (_) {}
+  if (!d) { cur.textContent = "Could not read the Tab5."; return; }
+  if (!d.host) {
+    cur.innerHTML = "Now: <b>USB</b> (the QMX on the Tab5's own USB port)" + (d.transport === "usb" ? " - connected" : " - not connected");
+  } else {
+    const where = d.port && d.port !== 7355 ? d.host + ":" + d.port : d.host;
+    cur.innerHTML = "Now: <b>NAS " + relayEsc(where) + "</b> - " +
+      (d.connected ? '<span style="color:#40c060">connected</span>' : relayEsc(d.last_error || "not connected"));
+    document.getElementById("relay-host").value = where;
+  }
+}
+
+async function relaySet(host, port) {
   try {
     const r = await fetch("/api/relay", { method: "POST", body: JSON.stringify({ host, port }) });
     if (!r.ok) throw new Error("HTTP " + r.status + " " + (await r.text()));
   } catch (err) {
     alert("Setting the radio source failed: " + err);
+    return;
   }
+  document.getElementById("relay-cur").textContent = host ? "Connecting to " + host + " ..." : "Switching to USB ...";
+  setTimeout(relayRefresh, 2500);
+}
+
+async function relayFind() {
+  const btn = document.getElementById("relay-find"), out = document.getElementById("relay-found");
+  btn.disabled = true; btn.textContent = "Searching...";
+  out.textContent = "Asking the network for a NAS running the QMX relay...";
+  let d = null;
+  try {
+    d = await (await fetch("/api/relay/find", { method: "POST" })).json();
+    for (let i = 0; i < 20 && d && d.searching; i++) {
+      await new Promise(r => setTimeout(r, 300));
+      d = await (await fetch("/api/relay/find", { cache: "no-store" })).json();
+    }
+  } catch (_) { d = null; }
+  btn.disabled = false; btn.textContent = "Find NAS";
+  if (!d || d.searching) { out.textContent = "No answer from the Tab5 - try again."; return; }
+  if (d.result < 0) { out.textContent = "The Tab5's WiFi is not connected - cannot search. Type the address instead."; return; }
+  if (!d.found.length) { out.textContent = "No NAS answered. Is the relay running, and on the same network as the Tab5?"; return; }
+  out.innerHTML = "Found: " + d.found.map(f => {
+    const where = f.port && f.port !== 7355 ? f.ip + ":" + f.port : f.ip;
+    return '<button class="btn-neutral relay-pick" data-ip="' + relayEsc(f.ip) + '" data-port="' + (f.port || 7355) +
+           '" title="Use this NAS">Use ' + relayEsc(where) + '</button>';
+  }).join(" ");
+  document.getElementById("relay-host").value = d.found[0].port && d.found[0].port !== 7355
+    ? d.found[0].ip + ":" + d.found[0].port : d.found[0].ip;
+  out.querySelectorAll(".relay-pick").forEach(b => b.addEventListener("click", () =>
+    relaySet(b.dataset.ip, parseInt(b.dataset.port, 10) || 7355)));
+}
+
+function relayOpen() {
+  document.getElementById("relay-modal").style.display = "";
+  document.getElementById("relay-found").textContent = "";
+  relayRefresh();
+}
+function relayClose() { document.getElementById("relay-modal").style.display = "none"; }
+document.getElementById("relay-close").addEventListener("click", relayClose);
+document.getElementById("relay-modal").addEventListener("click", (e) => { if (e.target.id === "relay-modal") relayClose(); });
+document.getElementById("relay-find").addEventListener("click", relayFind);
+document.getElementById("relay-usb").addEventListener("click", () => relaySet("", 7355));
+document.getElementById("relay-use").addEventListener("click", () => {
