+        portEXIT_CRITICAL(&s_sntp_mux);
+        // Carry the SNTP time forward by the hand-over delay (normally < 1 ms).
+        int64_t t_us = (int64_t)tv.tv_sec * 1000000LL + tv.tv_usec + (esp_timer_get_time() - at_us);
