index 8333457c..221207c7 100644
--- a/main/ft8_tx.c
+++ b/main/ft8_tx.c
@@ -31,6 +31,7 @@
 #include "ft8/js8_text.h"
 
 #include "cat/cat.h"
+#include "net/radio_relay.h"
 #include "storage/settings.h"
 
 static const char *TAG = "ft8_tx";
@@ -1336,7 +1337,36 @@ void ft8_tx_run(const ft8_tx_request_t *req)
             ESP_LOGI(TAG, "key down at +%lld ms into the slot", 
