         }
-        tx_cmd(t0, sim, "TX;");   // key down - radio's own envelope shaping
+        /* ⭐ RELAY-TIMED BURST (QMXR/1 "txsched=1").
+         * Over the NAS relay, 79 separate tone changes each had to cross WiFi
+         * on time, and twice in 20 test bursts (2026-10-14) one stalled for
+         * 1.1-1.5 s: the Tab5's own timing was perfect, the radio's was not.
+         * So the whole burst goes to the relay in one frame, and the relay
+         * keys the QMX, plays every tone on the NAS's clock over its wired
+         * link and USB, sends the key-up tone and reports back (TX_DONE).
+         * The loop below still runs on the Tab5 clock - for the UI progress,
+         * the live power/SWR query, SWR protection and abort - it just doesn't
+         * send the tones. Any failure handing the burst over falls back to the
+         * old tone-by-tone path, so a burst is never lost to this. */
+        bool relay_play = false;
+#if FT8_TX_SEND_LIVE
+        if (!sim && strcmp(cat_get_transport(), "net") == 0 && radio_relay_txsched_supported()) {
+            float *fr = malloc((size_t)nn * sizeof(float));
+            if (fr) {
+                for (int i = 0; i < nn; i++)
+                    fr[i] = (float)req->audio_freq_hz + (float)req->tones[i] * tone_spacing_hz;
+                esp_err_t se = radio_relay_tx_schedule(fr, nn, (uint32_t)symbol_period_us);
+                free(fr);
+                if (se == ESP_OK) {
+                    relay_play = true;
+                    ESP_LOGI(TAG, "burst handed to the relay (%d tones, relay-timed)", nn);
+                } else {
+                    ESP_LOGW(TAG, "relay-timed burst refused (0x%x) - sending tones from the Tab5", se);
+                }
+            }
+        }
+#endif
+        if (!relay_play) tx_cmd(t0, sim, "TX;");   // key down - radio's own envelope shaping
 
         // Live power/SWR: fire ONE non-blocking PC;SW; once the PA has settled
         // (symbol 6 ≈ 1 s in), then read the async response a few symbols later
@@ -1386,7 +1416,7 @@ void ft8_tx_run(const ft8_tx_request_t *req)
             }
             float freq = (float)req->audio_freq_hz + (float)req->tones[i] * tone_spacing_hz;
             sleep_until(t0, (int64_t)i * symbol_period_us);
-            tx_cmd(t0, sim, "TA%.2f;", (double)freq);
+            if (!relay_play) tx_cmd(t0, sim, "TA%.2f;", (double)freq);
             // Live power/SWR mid-burst query is FT8-only timing (tuned to FT8's
             // 160 ms symbol slack at symbols 6/14) and is skipped for FT4 on
             // those grounds alone - see the note on the branch below. This
@@ -1525,10 +1555,29 @@ void ft8_tx_run(const ft8_tx_request_t *req)
             // up - otherwise we'd truncate the last tone for receivers.
             sleep_until(t0, (int64_t)nn * symbol_period_us);
         }
+        // Relay-timed: the relay sends the key-up tone itself. Tell it to stop
+        // early on an abort, then wait for its report. If no report comes (link
+        // lost, old relay), fall through and send the key-up tone from here as
+        // well - a second TA0; is harmless, a missing one is not.
+        bool relay_keyed_up = false;
+#if FT8_TX_SEND_LIVE
+        if (relay_play) {
+            if (aborted) radio_relay_tx_abort();
+            radio_relay_tx_result_t rr;
+            if (radio_relay_tx_wait_done(aborted ? 1500 : 4000, &rr)) {
+                relay_keyed_up = true;
+                ESP_LOGI(TAG, "relay burst %s: %u/%d tones, RF on-air %lu ms, latest symbol %+ld ms (NAS clock)",
+                         rr.status == 0 ? "complete" : rr.status == 1 ? "aborted" : "FAILED",
+                         (unsigned)rr.tones_sent, nn, (unsigned long)rr.duration_ms, (long)rr.latest_ms);
+            } else {
+                ESP_LOGW(TAG, "no report from the relay for the burst - sending key-up from the Tab5");
+            }
+        }
+#endif
         // Either way - whether all symbols played or we broke out early
         // on an abort request - key up immediately now. This is the part
         // that must ALWAYS run: the radio must never be left transmitting.
-        {
+        if (!relay_keyed_up) {
             char keyup[24];
             snprintf(keyup, sizeof(keyup), "TA%.0f;", (double)FT8_TX_KEYUP_TONE_HZ);
             tx_cmd_critical(t0, sim, keyup);   // drops the envelope
diff --git a/main/net/radio_relay.c b/main/net/radio_relay.c
index 0873584e..982aeb2f 100644
--- a/main/net/radio_relay.c
+++ b/main/net/radio_relay.c
@@ -7,6 +7,7 @@
 
 #include "esp_log.h"
 #include "esp_timer.h"
+#include "esp_heap_caps.h"
 #include "freertos/FreeRTOS.h"
 #include "freertos/task.h"
 #include "freertos/semphr.h"
@@ -26,6 +27,9 @@ static const char *TAG = "relay";
 #define PROTO_TERM_STATUS 6   // relay -> Tab5: u8 ok (1/0) [+ reason text]
 #define PROTO_TERM_DATA   7   // both ways: bytes on the second serial port
 #define PROTO_TERM_CLOSE  8   // Tab5 -> relay: close it
+#define PROTO_TX_SCHED    9   // Tab5 -> relay: a whole transmit burst (see radio_relay.h)
+#define PROTO_TX_ABORT   10   // Tab5 -> relay: stop the burst now
+#define PROTO_TX_DONE    11   // relay -> Tab5: u8 status, u16 tones, u32 ms, i32 latest ms
 
 #define RX_PAYLOAD_MAX   8192     // NAS relay sends <=1920-byte IQ frames; anything larger is skipped
 #define RX_IDLE_TIMEOUT_S   3     // relay streams I/Q + 1 s PINGs; 3 s of silence == gone
@@ -53,6 +57,11 @@ static volatile int            s_term_result = 0;   // -1 waiting, 0 failed, 1 o
 static char                    s_term_err[64] = "";
 static int64_t s_last_fail_log_us = 0;
 
+// Relay-timed transmit bursts.
+static volatile bool s_txsched_supported = false;
+static SemaphoreHandle_t s_txdone_sem = NULL;
+static radio_relay_tx_result_t s_txdone;
+
 // ---- config ---------------------------------------------------------------
 
 void radio_relay_set_target(const char *host, uint16_t port)
@@ -201,10 +210,23 @@ static void rx_task(void *arg)
             }
             break;
         }
+        case PROTO_TX_DONE:
+            if (len >= 11) {
+                s_txdone.done        = true;
+                s_txdone.status      = payload[0];
+                s_txdone.tones_sent  = (uint16_t)(payload[1] | (payload[2] << 8));
+                s_txdone.duration_ms = (uint32_t)payload[3] | ((uint32_t)payload[4] << 8) |
+                                       ((uint32_t)payload[5] << 16) | ((uint32_t)payload[6] << 24);
+                s_txdone.latest_ms   = (int32_t)((uint32_t)payload[7] | ((uint32_t)payload[8] << 8) |
+                                       ((uint32_t)payload[9] << 16) | ((uint32_t)payload[10] << 24));
+                if (s_txdone_sem) xSemaphoreGive(s_txdone_sem);
+            }
+            break;
         default:   // HELLO / PING / unknown: nothing to do
             break;
         }
     }
+    if (s_txdone_sem) xSemaphoreGive(s_txdone_sem);   // a waiting burst must not wait for a dead link
 
     bool unexpected = !s_closing;
     s_connected = false;
@@ -343,6 +365,7 @@ esp_err_t radio_relay_connect(radio_relay_cat_rx_cb_t cat_cb,
     resp[len] = '\0';
     if (strncmp(resp, "QMXR/1", 6) != 0) { note_fail("bad protocol", 0); goto fail; }
     s_term_supported = strstr(resp, "term=1") != NULL;
+    s_txsched_supported = strstr(resp, "txsched=1") != NULL;
     if (!strstr(resp, "rate=48000")) {
         ESP_LOGW(TAG, "relay rate is not 48000 Hz (%s) - spectrum scale will be off", resp);
     }
@@ -382,6 +405,7 @@ void radio_relay_close(void)
     s_term_cb = NULL;
     s_term_gone_cb = NULL;
     s_term_supported = false;
+    s_txsched_supported = false;
     ESP_LOGI(TAG, "relay link closed");
 }
 
@@ -499,3 +523,47 @@ int radio_relay_discover(radio_relay_found_t *out, int max, uint32_t timeout_ms)
     ESP_LOGI(TAG, "discovery: %d relay(s) answered", n);
     return n;
 }
+
+// ---- relay-timed transmit bursts --------------------------------------------
+
+bool radio_relay_txsched_supported(void) { return s_connected && s_txsched_supported; }
+
+esp_err_t radio_relay_tx_schedule(const float *freq_hz, int n, uint32_t symbol_us)
+{
+    if (!radio_relay_txsched_supported()) return ESP_ERR_NOT_SUPPORTED;
+    if (!freq_hz || n <= 0 || n > 400) return ESP_ERR_INVALID_ARG;
+    if (!s_txdone_sem) {
+        s_txdone_sem = xSemaphoreCreateBinary();
+        if (!s_txdone_sem) return ESP_ERR_NO_MEM;
+    }
+    xSemaphoreTake(s_txdone_sem, 0);              // drop a stale signal
+    memset(&s_txdone, 0, sizeof(s_txdone));
+    /* u8 version, u8 flags, u16 n, u32 symbol_us, then n x u32 centi-Hz -
+     * centi-Hz so the relay can print exactly the "TA%.2f;" the Tab5 would. */
+    size_t len = 8 + (size_t)n * 4;
+    uint8_t *p = heap_caps_malloc(len, MALLOC_CAP_8BIT);
+    if (!p) return ESP_ERR_NO_MEM;
+    p[0] = 1; p[1] = 0; p[2] = (uint8_t)n; p[3] = (uint8_t)(n >> 8);
+    for (int b = 0; b < 4; b++) p[4 + b] = (uint8_t)(symbol_us >> (8 * b));
+    for (int i = 0; i < n; i++) {
+        uint32_t c = (uint32_t)(freq_hz[i] * 100.0f + 0.5f);
+        for (int b = 0; b < 4; b++) p[8 + i * 4 + b] = (uint8_t)(c >> (8 * b));
+    }
+    esp_err_t e = send_frame(PROTO_TX_SCHED, p, len, 500);
+    heap_caps_free(p);
+    return e;
+}
+
+esp_err_t radio_relay_tx_abort(void)
+{
+    if (!s_connected) return ESP_ERR_INVALID_STATE;
+    return send_frame(PROTO_TX_ABORT, NULL, 0, 500);
+}
+
+bool radio_relay_tx_wait_done(uint32_t timeout_ms, radio_relay_tx_result_t *out)
+{
+    bool got = s_txdone_sem && xSemaphoreTake(s_txdone_sem, pdMS_TO_TICKS(timeout_ms)) == pdTRUE
+               && s_txdone.done;
+    if (out) { *out = s_txdone; out->done = got; }
+    return got;
+}
diff --git a/main/net/radio_relay.h b/main/net/radio_relay.h
index 66a7a9bc..1ea06f03 100644
--- a/main/net/radio_relay.h
+++ b/main/net/radio_relay.h
@@ -86,6 +86,30 @@ typedef struct {
 } radio_relay_found_t;
 int radio_relay_discover(radio_relay_found_t *out, int max, uint32_t timeout_ms);
 
+/* ---- Relay-timed transmit bursts (QMXR/1 "txsched=1") ----------------------
+ * Over the network every tone change used to cross WiFi on its own, 160 ms
+ * apart, and a lost packet or a stalled WiFi link (2026-10-14: 1.1-1.5 s)
+ * delivered symbols late. Instead the whole burst goes to the relay in ONE
+ * frame at key-down; the relay keys the QMX, sends each tone on the NAS's own
+ * timer over its wired link and USB, sends the key-up tone, and reports back.
+ * Only relays that announce "txsched=1" in their HELLO accept it. */
+typedef struct {
+    bool     done;            // a TX_DONE arrived (false: timed out / link lost)
+    uint8_t  status;          // 0 complete, 1 aborted, 2 failed
+    uint16_t tones_sent;
+    uint32_t duration_ms;     // TX; -> key-up, NAS clock
+    int32_t  latest_ms;       // latest symbol vs its schedule, NAS clock
+} radio_relay_tx_result_t;
+
+bool      radio_relay_txsched_supported(void);
+/* Hand the burst to the relay: n tone frequencies (Hz), one every symbol_us.
+ * The relay keys the radio on receipt. */
+esp_err_t radio_relay_tx_schedule(const float *freq_hz, int n, uint32_t symbol_us);
+/* Stop a relay-timed burst now (the relay sends the key-up tone). */
+esp_err_t radio_relay_tx_abort(void);
+/* Wait for the relay's report that the burst (including key-up) is done. */
+bool      radio_relay_tx_wait_done(uint32_t timeout_ms, radio_relay_tx_result_t *out);
+
 /* Diagnostics for /api/relay. */
 uint32_t radio_relay_iq_pairs_total(void);
 const char *radio_relay_last_error(void);
diff --git a/tools/nas-relay/README.md b/tools/nas-relay/README.md
index 8cd0cd18..3281855a 100644
--- a/tools/nas-relay/README.md
+++ b/tools/nas-relay/README.md
@@ -249,6 +249,19 @@ Notes:
   `iq-during-tx` in the relay folder. Each burst in the transmit log records
   which way it ran ("I/Q to Tab5 paused" or "streamed").
 
+* **Transmit bursts timed by the relay:** with Tab5 firmware that supports it,
+  the Tab5 sends the whole burst (every tone) to the relay in one message at
+  key-down. The relay keys the QMX, sends each tone on the NAS's own clock, and
+  sends the key-up tone at the end, then reports back to the Tab5. The tones no
+  longer have to cross Wi-Fi one by one on time, so a Wi-Fi hiccup during the
+  burst can't delay a symbol. The Tab5 still sends its power/SWR query and the
+  final `RX;`. If the Tab5 disconnects mid-burst, the relay keys up and puts the
+  QMX back in receive. To go back to the Tab5 timing every tone (for an A/B
+  comparison), put a file named `tab5-timed-tx` in the relay folder; it takes
+  effect the next time the Tab5 connects. Each burst in the transmit log
+  records "tones timed by relay" or "tones timed by Tab5", and relay-sent
+  commands appear as `RELAY>QMX` in the CAT log.
+
 ## Troubleshooting
 
 * **Touch dead, but the screen and stream keep running, even after a restart:**
