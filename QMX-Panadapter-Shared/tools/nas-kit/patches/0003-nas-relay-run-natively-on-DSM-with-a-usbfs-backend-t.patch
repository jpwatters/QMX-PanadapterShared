+class UsbfsEndpoint:
+    def __init__(self, addr, attrs, mps):
+        self.a, self.attrs, self.mps = addr, attrs, mps
+
+    def getAddress(self):
+        return self.a
+
+    def getAttributes(self):
+        return self.attrs
+
+    def getMaxPacketSize(self):
+        return self.mps
