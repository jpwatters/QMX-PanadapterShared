From 6713fb436606add676510ecd69556222ce987231 Mon Sep 17 00:00:00 2001
From: J P <jpwatters@mac.com>
Date: Wed, 14 Oct 2026 22:12:27 -0500
Subject: [PATCH 20/42] Project PDFs and notes: v1.18.0 is the base throughout

The three project PDFs (M5StackTab5QMX+SharedOverNetwork.pdf,
QMX-Panadapter-Shared.pdf, QMX-Panadapter-SharedViaNAS.pdf) are rebuilt
from the v1.18.0-NAS code: firmware base v1.18.0, patch series 0001-0021,
listings as diffs against v1.18.0. QMX-Panadapter-Shared.pdf covers the
whole project; QMX-Panadapter-SharedViaNAS.pdf the Synology NAS part only.
CMakeLists.txt's version fallback and example are v1.18.0, and the notes in
idf_component.yml, the README and the relay README no longer name v1.16.11.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01W7MAsxUnuCnfwkHxdqp61S
---
 CMakeLists.txt                       |   6 +++---
 M5StackTab5QMX+SharedOverNetwork.pdf | Bin 402011 -> 402231 bytes
 QMX-Panadapter-Shared.pdf            | Bin 535216 -> 400642 bytes
 QMX-Panadapter-SharedViaNAS.pdf      | Bin 263085 -> 364897 bytes
 README.md                            |   2 +-
 main/idf_component.yml               |   6 +++---
 tools/nas-relay/README.md            |   2 +-
 7 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 987dc1b8..2da15b80 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -43,14 +43,14 @@ foreach(_gitdep ".git/HEAD" ".git/index" ".git/refs/tags" ".git/packed-refs")
 endforeach()
 
 # Network-radio build: report the release it is based on plus "-NAS"
-# (e.g. v1.16.11-NAS) instead of git describe's v1.16.11-3-g<hash>-dirty, which
+# (e.g. v1.18.0-NAS) instead of git describe's v1.18.0-3-g<hash>-dirty, which
 # is too long for the UI. The update check compares only the numbers before the
-# first '-', so v1.16.11-NAS counts as v1.16.11.
+# first '-', so v1.18.0-NAS counts as v1.18.0.
 execute_process(COMMAND git describe --tags --abbrev=0
                 WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
                 OUTPUT_VARIABLE QMX_BASE_TAG OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
 if(NOT QMX_BASE_TAG)
-    set(QMX_BASE_TAG "v1.16.11")
+    set(QMX_BASE_TAG "v1.18.0")
 endif()
 set(PROJECT_VER "${QMX_BASE_TAG}-NAS")
 
