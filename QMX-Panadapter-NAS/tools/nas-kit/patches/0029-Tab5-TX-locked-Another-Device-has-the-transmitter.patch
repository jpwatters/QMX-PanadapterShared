diff --git a/README.md b/README.md
index ad39f71b..3513676b 100644
--- a/README.md
+++ b/README.md
@@ -39,7 +39,7 @@ Here’s what the QMX+ PanadapterShared adds on top of upstream QMX-Panadapter,
 * No more freeze after boot: a network freeze about 20–50 s after boot, caused by the time update, is fixed.
 
 **Mac tools**
-* TCI bridge for the Mac (tools/mac-serial-bridge): WS (formerly WSJT-X Improved), WSJT-X 3 and JTDX use the NAS-shared QMX as a TCI network radio, with receive audio (from the I/Q), CAT and transmit (FT8/FT4/JS8/WSPR tones) in one connection; no serial port or virtual audio device. The Tab5 keeps its own connection; while a TCI program is connected the relay keeps the Tab5 off the transmitter (and the Mac off while the Tab5 transmits). Bench-tested against the relay's fake radio; not yet tested with WS on the air.
+* TCI bridge for the Mac (tools/mac-serial-bridge): WS (formerly WSJT-X Improved), WSJT-X 3 and JTDX use the NAS-shared QMX as a TCI network radio, with receive audio (from the I/Q), CAT and transmit (FT8/FT4/JS8/WSPR tones) in one connection; no serial port or virtual audio device. The Tab5 keeps its own connection; while a TCI program is connected the relay keeps the Tab5 off the transmitter, and the Tab5 shows “TX locked: Another Device has the transmitter” (and the Mac is kept off while the Tab5 transmits). Bench-tested against the relay's fake radio; not yet tested with WS on the air.
 * Build and flash from a Mac (tools/mac-build-flash.sh), and record the Tab5’s serial log (tools/mac-capture-serial.sh).
 
 **Keeping up with upstream**
diff --git a/main/ft8_tx.c b/main/ft8_tx.c
index 221207c7..84c2e6e6 100644
--- a/main/ft8_tx.c
+++ b/main/ft8_tx.c
@@ -32,6 +32,7 @@
 
 #include "cat/cat.h"
 #include "net/radio_relay.h"
+#include "ui.h"          // ui_toast_ms - "TX locked" must reach the screen, like wspr_tx.c
 #include "storage/settings.h"
 
 static const char *TAG = "ft8_tx";
@@ -908,6 +909,16 @@ bool ft8_tx_arm(const ft8_tx_request_t *req, char *out_err, size_t out_err_len)
         return false;
     }
 
+    // Another device has the transmitter (the NAS relay's one-transmitter
+    // lock: the Mac's TCI program, e.g. WS, is connected). The relay would drop
+    // the key-down anyway; refusing here says why instead of "transmitting"
+    // a burst that never reaches the air.
+    if (radio_relay_tx_locked(NULL, 0)) {
+        if (out_err) snprintf(out_err, out_err_len, "%s", RADIO_RELAY_TX_LOCKED_MSG);
+        ft8_status_set("%s", RADIO_RELAY_TX_LOCKED_MSG);
+        return false;
+    }
+
     // The operator has released the radio to its own front panel. Arming here
     // would key it from under their hands mid-menu: the TX burst writes TX;/TA;
     // straight to the CDC pipe and does NOT go through the paused poll task, so
@@ -1274,6 +1285,7 @@ void ft8_tx_run(const ft8_tx_request_t *req)
      * most - checked, because a dial at the top band edge puts the top tone
      * outside while the base is inside. */
     char band_err[160] = "";
+    char lock_why[128];
     const uint32_t tx_dial = sim ? 0u : cat_get_frequency();
     const bool band_ok = sim ? true
         : tx_band_guard_allows(tx_dial + (uint32_t)req->audio_freq_hz,
@@ -1284,6 +1296,12 @@ void ft8_tx_run(const ft8_tx_request_t *req)
         ESP_LOGE(TAG, "TX aborted before key-up: %s", band_err);
         ui_toast_ms(band_err, 15000);
         ft8_status_set("%s", band_err);
+    } else if (!sim && radio_relay_tx_locked(lock_why, sizeof(lock_why))) {
+        // Locked after this burst was armed (the TCI program connected in the
+        // meantime). Not keyed at all - the relay would drop it anyway.
+        ESP_LOGW(TAG, "TX not keyed: " RADIO_RELAY_TX_LOCKED_MSG " (%s)", lock_why);
+        ft8_status_set("%s", RADIO_RELAY_TX_LOCKED_MSG);
+        ui_toast_ms(RADIO_RELAY_TX_LOCKED_MSG, 6000);
     } else if (strcmp(mode, "DiGi") != 0) {
         ESP_LOGW(TAG, "TX aborted before key-up: mode drifted to '%s' (need DiGi)", mode);
     } else {
@@ -1569,6 +1587,13 @@ void ft8_tx_run(const ft8_tx_request_t *req)
                 ESP_LOGI(TAG, "relay burst %s: %u/%d tones, RF on-air %lu ms, latest symbol %+ld ms (NAS clock)",
                          rr.status == 0 ? "complete" : rr.status == 1 ? "aborted" : "FAILED",
                          (unsigned)rr.tones_sent, nn, (unsigned long)rr.duration_ms, (long)rr.latest_ms);
+                if (rr.status == 2 && radio_relay_tx_locked(NULL, 0)) {
+                    // The relay refused the burst: the lock arrived between
+                    // the check above and the hand-over.
+                    ESP_LOGW(TAG, "relay refused the burst: " RADIO_RELAY_TX_LOCKED_MSG);
+                    ft8_status_set("%s", RADIO_RELAY_TX_LOCKED_MSG);
+                    ui_toast_ms(RADIO_RELAY_TX_LOCKED_MSG, 6000);
+                }
             } else {
                 ESP_LOGW(TAG, "no report from the relay for the burst - sending key-up from the Tab5");
             }
diff --git a/main/net/radio_relay.c b/main/net/radio_relay.c
index 982aeb2f..fed5966e 100644
--- a/main/net/radio_relay.c
+++ b/main/net/radio_relay.c
@@ -30,6 +30,7 @@ static const char *TAG = "relay";
 #define PROTO_TX_SCHED    9   // Tab5 -> relay: a whole transmit burst (see radio_relay.h)
 #define PROTO_TX_ABORT   10   // Tab5 -> relay: stop the burst now
 #define PROTO_TX_DONE    11   // relay -> Tab5: u8 status, u16 tones, u32 ms, i32 latest ms
+#define PROTO_TX_LOCK    12   // relay -> Tab5: u8 locked (1/0) [+ reason text] - see radio_relay.h
 
 #define RX_PAYLOAD_MAX   8192     // NAS relay sends <=1920-byte IQ frames; anything larger is skipped
 #define RX_IDLE_TIMEOUT_S   3     // relay streams I/Q + 1 s PINGs; 3 s of silence == gone
@@ -62,6 +63,10 @@ static volatile bool s_txsched_supported = false;
 static SemaphoreHandle_t s_txdone_sem = NULL;
 static radio_relay_tx_result_t s_txdone;
 
+// Transmitter lock (QMXR/1 "txlock=1"): another device has the transmitter.
+static volatile bool s_tx_locked = false;
+static char          s_tx_lock_why[128] = "";
+
 // ---- config ---------------------------------------------------------------
 
 void radio_relay_set_target(const char *host, uint16_t port)
@@ -222,6 +227,21 @@ static void rx_task(void *arg)
                 if (s_txdone_sem) xSemaphoreGive(s_txdone_sem);
             }
             break;
+        case PROTO_TX_LOCK: {
+            bool locked = len >= 1 && payload[0] == 1;
+            size_t n = len > 1 ? len - 1 : 0;
+            if (n > sizeof(s_tx_lock_why) - 1) n = sizeof(s_tx_lock_why) - 1;
+            memcpy(s_tx_lock_why, payload + 1, n);
+            s_tx_lock_why[n] = '\0';
+            if (locked != s_tx_locked) {
+                if (locked)
+                    ESP_LOGW(TAG, RADIO_RELAY_TX_LOCKED_MSG " (relay: %s)", s_tx_lock_why);
+                else
+                    ESP_LOGI(TAG, "transmitter free again - the other device let it go");
+            }
+            s_tx_locked = locked;
+            break;
+        }
         default:   // HELLO / PING / unknown: nothing to do
             break;
         }
@@ -366,6 +386,8 @@ esp_err_t radio_relay_connect(radio_relay_cat_rx_cb_t cat_cb,
     if (strncmp(resp, "QMXR/1", 6) != 0) { note_fail("bad protocol", 0); goto fail; }
     s_term_supported = strstr(resp, "term=1") != NULL;
     s_txsched_supported = strstr(resp, "txsched=1") != NULL;
+    s_tx_locked = false;              // the relay sends TX_LOCK right after its HELLO
+    s_tx_lock_why[0] = '\0';
     if (!strstr(resp, "rate=48000")) {
         ESP_LOGW(TAG, "relay rate is not 48000 Hz (%s) - spectrum scale will be off", resp);
     }
@@ -406,6 +428,7 @@ void radio_relay_close(void)
     s_term_gone_cb = NULL;
     s_term_supported = false;
     s_txsched_supported = false;
+    s_tx_locked = false;
     ESP_LOGI(TAG, "relay link closed");
 }
 
@@ -528,6 +551,13 @@ int radio_relay_discover(radio_relay_found_t *out, int max, uint32_t timeout_ms)
 
 bool radio_relay_txsched_supported(void) { return s_connected && s_txsched_supported; }
 
+bool radio_relay_tx_locked(char *why, size_t cap)
+{
+    bool locked = s_connected && s_tx_locked;
+    if (why && cap) snprintf(why, cap, "%s", locked ? s_tx_lock_why : "");
+    return locked;
+}
+
 esp_err_t radio_relay_tx_schedule(const float *freq_hz, int n, uint32_t symbol_us)
 {
     if (!radio_relay_txsched_supported()) return ESP_ERR_NOT_SUPPORTED;
diff --git a/main/net/radio_relay.h b/main/net/radio_relay.h
index 1ea06f03..90cdd46f 100644
--- a/main/net/radio_relay.h
+++ b/main/net/radio_relay.h
@@ -11,6 +11,8 @@
  *     u8 type | u8 flags | u16 len (LE) | payload
  *       1=HELLO 2=IQ 3=CAT 4=PING
  *       5=TERM_OPEN 6=TERM_STATUS 7=TERM_DATA 8=TERM_CLOSE   (relay says "term=1")
+ *       9=TX_SCHED 10=TX_ABORT 11=TX_DONE                    (relay says "txsched=1")
+ *       12=TX_LOCK                                           (relay says "txlock=1")
  *
  * IQ payloads are interleaved int16 LE I/Q pairs at 48 kHz, already scaled
