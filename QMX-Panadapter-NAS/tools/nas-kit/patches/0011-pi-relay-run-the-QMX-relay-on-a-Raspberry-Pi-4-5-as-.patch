+++ b/tools/pi-relay/logrotate/qmx-relay
@@ -0,0 +1,10 @@
+/var/log/qmx-relay/qmx-relay.log {
+    weekly
+    rotate 8
+    maxsize 5M
+    compress
+    delaycompress
+    missingok
+    notifempty
+    copytruncate
+}
diff --git a/tools/pi-relay/qmx-relay-ctl b/tools/pi-relay/qmx-relay-ctl
new file mode 100755
index 00000000..fd3b8116
--- /dev/null
+++ b/tools/pi-relay/qmx-relay-ctl
@@ -0,0 +1,91 @@
+#!/bin/sh
+# qmx-relay-ctl - look after the QMX relay service on this Raspberry Pi.
+#
+#   qmx-relay-ctl status          service, timer, restarts used, ports, QMX on USB, last log lines
+#   qmx-relay-ctl log [N]         last N log lines (default 50)
+#   qmx-relay-ctl follow          follow the log as it is written (Ctrl-C to stop)
+#   qmx-relay-ctl test            network test against the running relay (read-only, never transmits)
+#   qmx-relay-ctl probe           list the USB devices and the QMX's interfaces
+#   sudo qmx-relay-ctl restart    start again now, with a fresh set of 3 restarts
+#   sudo qmx-relay-ctl stop       stop it (it starts again 60 s after the next boot)
+#   sudo qmx-relay-ctl start      start it now if stopped
+
+OPT=/opt/qmx-relay
+LOG=/var/log/qmx-relay/qmx-relay.log
+UNIT=qmx-relay.service
+EVENT="$OPT/qmx-relay-event.sh"
+
+need_root() {
+    [ "$(id -u)" = 0 ] || { echo "Run this with sudo: sudo qmx-relay-ctl $1"; exit 1; }
+}
+
+who_did() { echo "${SUDO_USER:-$(id -un)}"; }
+
+qmx_on_usb() {
+    for d in /sys/bus/usb/devices/*; do
+        [ -f "$d/idVendor" ] || continue
+        if [ "$(cat "$d/idVendor")" = "0483" ] && [ "$(cat "$d/idProduct")" = "a34c" ]; then
+            echo "yes ($(cat "$d/product" 2>/dev/null || echo QMX), bus $(cat "$d/busnum") device $(cat "$d/devnum"))"
+            return
+        fi
+    done
+    echo "NO - is the QMX switched on and plugged in with a data cable?"
+}
+
+case "${1:-status}" in
+status)
+    echo "QMX relay on $(uname -n)"
+    echo "  service : $(systemctl is-active $UNIT 2>/dev/null)  (restarts used: $(systemctl show -p NRestarts --value $UNIT 2>/dev/null) of 3)"
+    res="$(systemctl show -p Result --value $UNIT 2>/dev/null)"
+    [ -n "$res" ] && [ "$res" != "success" ] && echo "  result  : $res  -> 'sudo qmx-relay-ctl restart' starts it again"
+    echo "  timer   : $(systemctl is-enabled qmx-relay.timer 2>/dev/null) (starts the relay 60 s after boot)"
+    echo "  uptime  : $(cut -d. -f1 /proc/uptime) s"
+    echo "  QMX USB : $(qmx_on_usb)"
+    if command -v ss >/dev/null 2>&1; then
+        echo "  ports   :"
+        ss -ltnu 2>/dev/null | awk 'NR > 1 && $5 ~ /:735[56]$/ { print "            " $1 " " $5 }'
+    fi
+    echo "  log     : $LOG"
+    echo
+    tail -n 15 "$LOG" 2>/dev/null
+    ;;
+log)
+    tail -n "${2:-50}" "$LOG"
+    ;;
+follow)
+    tail -n 20 -F "$LOG"
+    ;;
+test)
+    python3 "$OPT/nettest.py" 127.0.0.1
+    ;;
+probe)
+    need_root probe
+    QMX_BACKEND="${QMX_BACKEND:-usbfs}" python3 "$OPT/qmx_nas_relay.py" --probe
+    ;;
+restart)
+    need_root restart
+    "$EVENT" note "manual restart by $(who_did): restart count and limit reset."
+    systemctl reset-failed $UNIT 2>/dev/null
+    systemctl restart $UNIT
+    sleep 2
+    systemctl is-active $UNIT
+    ;;
+start)
+    need_root start
+    "$EVENT" note "manual start by $(who_did)."
+    systemctl reset-failed $UNIT 2>/dev/null
+    systemctl start $UNIT
+    sleep 2
+    systemctl is-active $UNIT
+    ;;
+stop)
+    need_root stop
+    "$EVENT" note "manual stop by $(who_did) (it starts again 60 s after the next boot)."
+    systemctl stop $UNIT
+    systemctl is-active $UNIT
+    ;;
+*)
+    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
+    exit 1
+    ;;
+esac
diff --git a/tools/pi-relay/qmx-relay-event.sh b/tools/pi-relay/qmx-relay-event.sh
new file mode 100755
index 00000000..80f6efcb
--- /dev/null
+++ b/tools/pi-relay/qmx-relay-event.sh
@@ -0,0 +1,90 @@
+#!/bin/sh
+# qmx-relay-event.sh - write what happens to the QMX relay service into its log,
+# /var/log/qmx-relay/qmx-relay.log (the relay's own output goes to the same file).
+#
+# Called by systemd:
+#   boot    qmx-relay-boot.service    the system booted; the relay starts 60 s later
+#   start   ExecStartPre              the relay is starting (first start, restart n of 3, or by hand)
+#   stop    ExecStopPost              the relay stopped: why, and whether it will be restarted
+#   gaveup  OnFailure                 the 3 restarts are used up; it stays stopped
+# and by qmx-relay-ctl:
+#   note "text"                       a line of its own (manual start/stop/restart)
+#
+# It never fails, so it can never stop the relay from starting.
+
+LOGDIR=/var/log/qmx-relay
+LOG="$LOGDIR/qmx-relay.log"
+UNIT=qmx-relay.service
+MAX_RESTARTS=3          # keep in step with StartLimitBurst=4 in qmx-relay.service
+RESTART_SEC=10          # keep in step with RestartSec= in qmx-relay.service
+BOOT_DELAY=60           # keep in step with OnBootSec= in qmx-relay.timer
+
+mkdir -p "$LOGDIR" 2>/dev/null
+
+say() {
+    printf '%s SERVICE %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG" 2>/dev/null
+}
+
+uptime_s() { cut -d. -f1 /proc/uptime 2>/dev/null || echo "?"; }
+
+nrestarts() {
+    n="$(systemctl show -p NRestarts --value "$UNIT" 2>/dev/null)"
+    case "$n" in ''|*[!0-9]*) echo 0 ;; *) echo "$n" ;; esac
+}
+
+case "$1" in
+boot)
+    say "---- system booted (uptime $(uptime_s) s, $(uname -n), kernel $(uname -r))."
+    say "relay will be started by qmx-relay.timer ${BOOT_DELAY} s after boot."
+    ;;
+start)
+    n="$(nrestarts)"
+    up="$(uptime_s)"
+    if [ "$n" -gt 0 ] 2>/dev/null; then
+        say "starting the relay: restart $n of $MAX_RESTARTS (uptime $up s)."
+    elif [ "$up" != "?" ] && [ "$up" -lt $((BOOT_DELAY + 60)) ]; then
+        say "starting the relay: ${BOOT_DELAY} s after boot, by qmx-relay.timer (uptime $up s)."
+    else
+        say "starting the relay (uptime $up s)."
+    fi
+    say "command: python3 qmx_nas_relay.py ${RELAY_ARGS:-}   backend: ${QMX_BACKEND:-auto}"
+    ;;
+stop)
+    n="$(nrestarts)"
+    res="${SERVICE_RESULT:-unknown}"; code="${EXIT_CODE:-?}"; st="${EXIT_STATUS:-?}"
+    case "$res" in
+    success)
+        if [ "$code" = "exited" ]; then
+            say "relay exited normally (status $st); not restarted."
+        else
+            say "relay stopped on request ($code $st)."
+        fi
+        ;;
+    *)
+        case "$code" in
+            exited) why="exited with status $st" ;;
+            killed) why="was killed by signal $st" ;;
+            dumped) why="crashed (signal $st, core dumped)" ;;
+            *)      why="stopped ($code $st)" ;;
+        esac
+        if [ "$n" -lt "$MAX_RESTARTS" ] 2>/dev/null; then
+            say "relay FAILED: it $why (result: $res). Restart $((n + 1)) of $MAX_RESTARTS in ${RESTART_SEC} s."
+        else
+            say "relay FAILED: it $why (result: $res). All $MAX_RESTARTS restarts used - not restarting."
+        fi
+        ;;
+    esac
+    ;;
+gaveup)
+    say "GAVE UP: the relay failed and its $MAX_RESTARTS restarts are used up. It stays stopped"
+    say "until the next reboot or 'sudo qmx-relay-ctl restart'. See the lines above for why."
+    ;;
+note)
+    shift
+    say "$*"
+    ;;
+*)
+    say "qmx-relay-event.sh: unknown event '$1'"
+    ;;
+esac
+exit 0
