From 912f4271c5d87c3b3a63c24ddb3a7b9f44f99ef4 Mon Sep 17 00:00:00 2001
From: J P <1953637+jpwatters@users.noreply.github.com>
Date: Sun, 22 Nov 2026 13:25:45 -0600
Subject: [PATCH 53/54] TX locked: the refusal uses upstream's red alert toast
 (v2.1.0)

Upstream v2.1.0 shows every "did not transmit" refusal in the opaque,
red-framed alert toast that any tap closes (ui_toast_alert_ms). The NAS's
"TX locked: Another Device has the transmitter" refusals on the FT8 key-down
and relay-burst paths, WSPR, Tune and power calibration now do the same,
and say that nothing went out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01W7MAsxUnuCnfwkHxdqp61S
---
 main/ft8_tx.c             | 4 ++--
 main/ui/power_cal_modal.c | 2 +-
 main/ui/tune_modal.c      | 2 +-
 main/wspr_tx.c            | 2 +-
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/main/ft8_tx.c b/main/ft8_tx.c
index 50d021d5..9d7c26f9 100644
--- a/main/ft8_tx.c
+++ b/main/ft8_tx.c
@@ -1331,7 +1331,7 @@ void ft8_tx_run(const ft8_tx_request_t *req)
         // meantime). Not keyed at all - the relay would drop it anyway.
         ESP_LOGW(TAG, "TX not keyed: " RADIO_RELAY_TX_LOCKED_MSG " (%s)", lock_why);
         ft8_status_set("%s", RADIO_RELAY_TX_LOCKED_MSG);
-        ui_toast_ms(RADIO_RELAY_TX_LOCKED_MSG, 6000);
+        ui_toast_alert_ms(RADIO_RELAY_TX_LOCKED_MSG " - FT8 did not transmit.", 8000);
     } else if (strcmp(mode, "DiGi") != 0) {
         ESP_LOGW(TAG, "TX aborted before key-up: mode drifted to '%s' (need DiGi)", mode);
     } else {
@@ -1622,7 +1622,7 @@ void ft8_tx_run(const ft8_tx_request_t *req)
                     // the check above and the hand-over.
                     ESP_LOGW(TAG, "relay refused the burst: " RADIO_RELAY_TX_LOCKED_MSG);
                     ft8_status_set("%s", RADIO_RELAY_TX_LOCKED_MSG);
-                    ui_toast_ms(RADIO_RELAY_TX_LOCKED_MSG, 6000);
+                    ui_toast_alert_ms(RADIO_RELAY_TX_LOCKED_MSG " - FT8 did not transmit.", 8000);
                 }
             } else {
                 ESP_LOGW(TAG, "no report from the relay for the burst - sending key-up from the Tab5");
diff --git a/main/ui/power_cal_modal.c b/main/ui/power_cal_modal.c
index 9eb32465..19979d48 100644
--- a/main/ui/power_cal_modal.c
+++ b/main/ui/power_cal_modal.c
@@ -769,7 +769,7 @@ static void start_btn_cb(lv_event_t *e)
         return;
     }
     if (radio_relay_tx_locked(NULL, 0)) {
-        ui_toast(RADIO_RELAY_TX_LOCKED_MSG);
+        ui_toast_alert_ms(RADIO_RELAY_TX_LOCKED_MSG " - nothing was transmitted.", 8000);
         return;
     }
     if (ft8_tx_get_status(NULL, 0, NULL) != FT8_TX_IDLE) {
diff --git a/main/ui/tune_modal.c b/main/ui/tune_modal.c
index a1fd3076..0aa5a0d6 100644
--- a/main/ui/tune_modal.c
+++ b/main/ui/tune_modal.c
@@ -110,7 +110,7 @@ static void action_btn_cb(lv_event_t *e)
     }
     // Another device has the transmitter: the relay drops Tune (MD8;) too.
     if (radio_relay_tx_locked(NULL, 0)) {
-        ui_toast(RADIO_RELAY_TX_LOCKED_MSG);
+        ui_toast_alert_ms(RADIO_RELAY_TX_LOCKED_MSG " - nothing was transmitted.", 8000);
         return;
     }
     /* ⛔ BAND GUARD (T48). Tune keys a CARRIER, and in MD8 the emitted RF is
diff --git a/main/wspr_tx.c b/main/wspr_tx.c
index 66b826a6..6fad9515 100644
--- a/main/wspr_tx.c
+++ b/main/wspr_tx.c
@@ -551,7 +551,7 @@ static void run_burst(const wspr_tx_request_t *req)
     // "burst starting" line, for the same reason as the SWR check above.
     if (!s_burst_sim && radio_relay_tx_locked(NULL, 0)) {
         ESP_LOGW(TAG, "WSPR TX REFUSED: " RADIO_RELAY_TX_LOCKED_MSG);
-        ui_toast_ms(RADIO_RELAY_TX_LOCKED_MSG, 8000);
+        ui_toast_alert_ms(RADIO_RELAY_TX_LOCKED_MSG " - WSPR did not transmit.", 8000);
         s_state = WSPR_TX_IDLE;
         return;
     }
