    then held disabled briefly: the device defers the request to its own 1 Hz timer,
    so a second click inside that window would do nothing visible and invite
    double-tapping. */
+/* 10-burst test (network-radio), shown only at http://qmx.local/?test.
+   One click sets up a transmit timing test:
+   CQ "Stop after" = 10 calls and no listening slot, so the ten bursts follow
+   each other with nothing skipped; switches the Tab5 to FT8 if needed; starts
+   the CQ run; counts the bursts from /api/status; and when the run ends -
+   ten sent, answered, cancelled - puts both settings back as they were.
+   The previous values are kept in localStorage so a reload mid-run still
+   restores them. Compare the result with tools/tx-test/tx_compare.py. */
+(function wireBurstTest() {
+  const btn = document.getElementById("burst-test");
+  if (!btn) return;
+  const KEY = "qmxBurstTest";
+  const N = 10;
+  let st = null;                       // { prev:{max_calls,listen_every}, sent, active, phase }
+  try { st = JSON.parse(localStorage.getItem(KEY) || "null"); } catch (e) { st = null; }
+  /* Test equipment, not an operating control: the button only appears when the
+     page is opened as http://qmx.local/?test (or while a test it started is
+     still running, so it can always be stopped). Everyone else never sees it. */
+  if (!/[?&]test\b/.test(location.search) && !st) return;
+  btn.hidden = false;
+  const save = () => { try { st ? localStorage.setItem(KEY, JSON.stringify(st)) : localStorage.removeItem(KEY); } catch (e) {} };
+  const label = (t) => { btn.textContent = t; };
+  const postCq = (cq) => fetch("/api/settings", {
+    method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ cq })
+  }).then(r => r.ok).catch(() => false);
+
+  async function finish(why) {
+    if (!st || st.phase === "finishing") return;
+    st.phase = "finishing";              // the next status poll must not finish it twice
+    const prev = st.prev, sent = st.sent;
+    label("Restoring...");
+    const ok = await postCq({ max_calls: prev.max_calls, listen_every: prev.listen_every });
+    st = null; save();
+    btn.disabled = false;
+    label("10-burst test");
+    alert("10-burst test " + why + ": " + sent + " burst(s) sent.\n" +
+          (ok ? "CQ settings restored (Stop after: " + (prev.max_calls || "never") +
+                ", listening slot: " + (prev.listen_every || "off") + ")."
+              : "Could not restore the CQ settings - set them back in Settings > CQ messages.") +
+          "\n\nNow save the Tab5 log: open /api/log (it empties the Tab5's log), " +
+          "and download txlog from the NAS.");
+  }
+
+  btn.addEventListener("click", async () => {
+    if (st) {                             // running: this click stops it
+      if (!confirm("Stop the 10-burst test now? The CQ run is cancelled and the settings restored.")) return;
+      await sendCmd({ action: "qso_override", what: "cancel" });
+      await finish("stopped");
+      return;
+    }
+    if (!confirm("Start a 10-burst test?\n\nThe Tab5 calls CQ ten times in a row (every other " +
+                 "15 s slot, about 5 minutes) and transmits each time. Use a dummy load, or make " +
+                 "sure the frequency is clear and you are licensed to transmit on it.\n\n" +
+                 "CQ settings are changed for the test and put back afterwards.")) return;
+    btn.disabled = true; label("Preparing...");
+    let cfg = null;
+    try { cfg = await (await fetch("/api/settings", { cache: "no-store" })).json(); } catch (e) {}
+    if (!cfg || !cfg.cq) { btn.disabled = false; label("10-burst test"); alert("Could not read the Tab5's settings."); return; }
+    st = { prev: { max_calls: cfg.cq.max_calls || 0, listen_every: cfg.cq.listen_every || 0 },
+           sent: 0, active: false, phase: "starting", t0: Date.now() };
+    save();
+    if (!(await postCq({ max_calls: N, listen_every: 0 }))) { await finish("could not start"); return; }
+    let screen = "";
+    try { screen = (await (await fetch("/api/status", { cache: "no-store" })).json()).screen || ""; } catch (e) {}
+    if (screen !== "ft8") {
+      await sendCmd({ action: "set_screen", screen: "ft8" });
+      await new Promise(r => setTimeout(r, 4000));      // let the FT8 engine start
+    }
+    await sendCmd({ action: "cq_start" });
+    st.phase = "running"; save();
+    btn.disabled = false; label("Burst 0 of " + N + " - stop");
+  });
+
+  /* Called from the /api/status handler once per poll. */
+  window.burstTestOnStatus = function (s) {
+    if (!st || st.phase !== "running" || !s || !s.ft8) return;
+    const f = s.ft8, now = f.st || "idle";
+    if (now === "active" && !st.active) { st.active = true; }
+    else if (now !== "active" && st.active) { st.active = false; st.sent++; save(); }
+    label((st.active ? "Burst " + (st.sent + 1) : "Burst " + st.sent) + " of " + N + " - stop");
+    const text = f.text || "";
+    const elapsed = Date.now() - (st.t0 || 0);
+    if (!st.active && (st.sent >= N || /sent - listening/.test(text))) { finish("finished"); return; }
+    // ended some other way: answered (QSO done/timeout), cancelled, or never got going
+    if (!st.active && elapsed > 60000 && (now === "idle" || now === "done" || now === "timeout")) {
+      finish(st.sent ? "ended early" : "did not start"); return;
+    }
+  };
+  if (st) { label("Burst " + st.sent + " of " + N + " - stop"); st.phase = "running"; }
+})();
+
 (function wireCqRestart() {
   const btn = document.getElementById("cq-restart");
   if (!btn) return;
