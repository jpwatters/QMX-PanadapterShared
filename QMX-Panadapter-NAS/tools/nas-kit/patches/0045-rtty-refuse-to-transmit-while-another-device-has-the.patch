From 8a4d37956aa8a2fc7fbdef8061c1ac8913719ee7 Mon Sep 17 00:00:00 2001
From: J P <1953637+jpwatters@users.noreply.github.com>
Date: Sun, 15 Nov 2026 08:25:57 -0600
Subject: [PATCH 45/54] rtty: refuse to transmit while another device has the
 transmitter

v2.0.0 adds RTTY transmit. Like FT8/FT4 and WSPR, an RTTY over now refuses
with "TX locked: Another Device has the transmitter" while the NAS relay
reports that the Mac's TCI bridge holds the transmitter (the relay would
drop the Tab5's TX; and tones anyway).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01W7MAsxUnuCnfwkHxdqp61S
---
 main/rtty_tx.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/main/rtty_tx.c b/main/rtty_tx.c
index 3292e3e9..f089bc75 100644
--- a/main/rtty_tx.c
+++ b/main/rtty_tx.c
@@ -11,6 +11,7 @@
 #include "tx_band_guard.h"
 #include "wspr_rx.h"
 #include "cat/cat.h"
+#include "net/radio_relay.h"   // radio_relay_tx_locked - another device has the transmitter
 #include "storage/settings.h"
 #include "ui/ui.h"
 
@@ -285,6 +286,10 @@ static esp_err_t start_over(char *err, size_t err_len)
         snprintf(err, err_len, "another transmission holds the radio"); return ESP_ERR_INVALID_STATE;
     }
     if (wspr_rx_running())          { snprintf(err, err_len, "WSPR is running"); return ESP_ERR_INVALID_STATE; }
+    /* network radio: while the NAS relay reports that another device (the Mac's
+     * TCI bridge) has the transmitter, the relay would drop TX; and every tone
+     * anyway - refuse here and say why, as FT8/FT4 and WSPR do. */
+    if (radio_relay_tx_locked(NULL, 0)) { snprintf(err, err_len, "%s", RADIO_RELAY_TX_LOCKED_MSG); return ESP_ERR_INVALID_STATE; }
 
     rtty_rx_status_t rs; rtty_rx_status(&rs);
     if (!rs.cfg.on)                 { snprintf(err, err_len, "RTTY page is not open"); return ESP_ERR_INVALID_STATE; }
-- 
