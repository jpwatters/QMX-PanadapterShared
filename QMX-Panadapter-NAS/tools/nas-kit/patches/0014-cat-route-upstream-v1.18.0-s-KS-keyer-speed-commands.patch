From b91bb68c3594bade1853b468c42513be6a498aa0 Mon Sep 17 00:00:00 2001
From: J P <jpwatters@mac.com>
Date: Wed, 14 Oct 2026 07:13:43 -0500
Subject: [PATCH 14/22] cat: route upstream v1.18.0's KS keyer-speed commands
 through cat_tx, so they work on a network radio

v1.18.0 added a keyer-speed query (KS;) and set (KSnnn;) that write straight
to s_cdc_dev. On a network radio s_cdc_dev is NULL, so both went nowhere.
Same fix as the GP/TM probes in v1.16.12: send through cat_tx(), which picks
USB or the NAS relay.
---
 main/cat/cat.c | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/main/cat/cat.c b/main/cat/cat.c
index 6793b9ac..e8956511 100644
--- a/main/cat/cat.c
+++ b/main/cat/cat.c
@@ -2134,7 +2134,7 @@ static void poll_task(void *arg)
         if (s_keyer_query_pending) {
             s_keyer_query_pending = false;
             static const char q[] = "KS;";
-            esp_err_t err = cdc_acm_host_data_tx_blocking(s_cdc_dev, (const uint8_t *)q, 3, 200);
+            esp_err_t err = cat_tx((const uint8_t *)q, 3, 200);   /* network radio: cat_tx, not s_cdc_dev */
             ESP_LOGI(TAG, "Keyer speed query KS; (%s)", err == ESP_OK ? "sent" : "fail");
             vTaskDelay(pdMS_TO_TICKS(CAT_POLL_INTERVAL_MS));
             continue;
@@ -2147,8 +2147,7 @@ static void poll_task(void *arg)
              * same shape its AG/RG commands use. */
             char cmd[16];
             int n = snprintf(cmd, sizeof cmd, "KS%03u;", ks);
-            esp_err_t err = cdc_acm_host_data_tx_blocking(s_cdc_dev, (const uint8_t *)cmd,
-                                                          (size_t)n, 200);
+            esp_err_t err = cat_tx((const uint8_t *)cmd, (size_t)n, 200);   /* network radio */
             ESP_LOGI(TAG, "Keyer speed -> %s (%s)", cmd, err == ESP_OK ? "ok" : "fail");
             /* ⛔ ALWAYS READ BACK. A successful CDC write only proves the
              * bytes reached the radio - the lesson Q9/IQ mode taught the hard
