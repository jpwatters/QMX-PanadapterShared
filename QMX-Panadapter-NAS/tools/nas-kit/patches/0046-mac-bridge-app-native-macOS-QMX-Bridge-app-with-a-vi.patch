@@ -0,0 +1,208 @@
+// Net.swift - small blocking BSD-socket helpers (the bridge runs on its own
+// threads, like the Python version, so plain sockets keep the port simple).
+
+import Foundation
+import Darwin
+
+enum NetError: Error, CustomStringConvertible {
+    case resolve(String)
+    case sys(String, Int32)
+    case timeout(String)
+    case closed
+
+    var description: String {
+        switch self {
+        case .resolve(let h): return "can't resolve \(h)"
+        case .sys(let what, let e): return "\(what): \(String(cString: strerror(e)))"
+        case .timeout(let what): return "\(what): timed out"
+        case .closed: return "connection closed"
+        }
+    }
+
+    var errno: Int32? { if case .sys(_, let e) = self { return e }; return nil }
+}
+
+/// A connected TCP socket.
+final class TCPSocket {
+    let fd: Int32
+    private var closedFlag = false
+    private let lock = NSLock()
+
+    init(fd: Int32) { self.fd = fd }
+    deinit { close() }
+
+    /// Connect to host:port with a timeout (seconds).
+    static func connect(host: String, port: Int, timeout: Double) throws -> TCPSocket {
+        var addr = sockaddr_in()
+        addr.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+        addr.sin_family = sa_family_t(AF_INET)
+        addr.sin_port = in_port_t(UInt16(port).bigEndian)
+        if inet_pton(AF_INET, host, &addr.sin_addr) != 1 {
+            // not a dotted quad: resolve
+            var hints = addrinfo(ai_flags: 0, ai_family: AF_INET, ai_socktype: SOCK_STREAM,
+                                 ai_protocol: 0, ai_addrlen: 0, ai_canonname: nil, ai_addr: nil, ai_next: nil)
+            var res: UnsafeMutablePointer<addrinfo>?
+            guard getaddrinfo(host, nil, &hints, &res) == 0, let r = res, let sa = r.pointee.ai_addr else {
+                throw NetError.resolve(host)
+            }
+            sa.withMemoryRebound(to: sockaddr_in.self, capacity: 1) { addr.sin_addr = $0.pointee.sin_addr }
+            freeaddrinfo(res)
+        }
+        let fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP)
+        if fd < 0 { throw NetError.sys("socket", Darwin.errno) }
+        var one: Int32 = 1
+        setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, socklen_t(MemoryLayout<Int32>.size))
+        let flags = fcntl(fd, F_GETFL)
+        _ = fcntl(fd, F_SETFL, flags | O_NONBLOCK)
+        let rc = withUnsafePointer(to: &addr) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+                Darwin.connect(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
+            }
+        }
+        if rc != 0 {
+            let e = Darwin.errno
+            if e != EINPROGRESS { Darwin.close(fd); throw NetError.sys("connect \(host):\(port)", e) }
+            var p = pollfd(fd: fd, events: Int16(POLLOUT), revents: 0)
+            let n = poll(&p, 1, Int32(timeout * 1000))
+            if n <= 0 { Darwin.close(fd); throw NetError.timeout("connect \(host):\(port)") }
+            var err: Int32 = 0
+            var len = socklen_t(MemoryLayout<Int32>.size)
+            getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &len)
+            if err != 0 { Darwin.close(fd); throw NetError.sys("connect \(host):\(port)", err) }
+        }
+        _ = fcntl(fd, F_SETFL, flags & ~O_NONBLOCK)
+        setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, socklen_t(MemoryLayout<Int32>.size))
+        setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &one, socklen_t(MemoryLayout<Int32>.size))
+        return TCPSocket(fd: fd)
+    }
+
+    var isClosed: Bool { lock.lock(); defer { lock.unlock() }; return closedFlag }
+
+    func close() {
+        lock.lock()
+        if !closedFlag {
+            closedFlag = true
+            Darwin.shutdown(fd, SHUT_RDWR)
+            Darwin.close(fd)
+        }
+        lock.unlock()
+    }
+
+    /// Receive timeout for blocking reads; 0 = none.
+    func setReadTimeout(_ seconds: Double) {
+        var tv = timeval(tv_sec: Int(seconds), tv_usec: Int32((seconds - Double(Int(seconds))) * 1e6))
+        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, socklen_t(MemoryLayout<timeval>.size))
+    }
+
+    func sendAll(_ data: Data) throws {
+        try data.withUnsafeBytes { (raw: UnsafeRawBufferPointer) in
+            guard var p = raw.baseAddress else { return }
+            var left = raw.count
+            while left > 0 {
+                let n = Darwin.send(fd, p, left, 0)
+                if n < 0 {
+                    if Darwin.errno == EINTR { continue }
+                    throw NetError.sys("send", Darwin.errno)
+                }
+                p += n
+                left -= n
+            }
+        }
+    }
+
+    func sendAll(_ s: String) throws { try sendAll(Data(s.utf8)) }
+
+    /// Up to `max` bytes; empty Data = peer closed. Throws on error or timeout.
+    func recv(max: Int = 4096) throws -> Data {
+        var buf = [UInt8](repeating: 0, count: max)
+        while true {
+            let n = Darwin.recv(fd, &buf, max, 0)
+            if n >= 0 { return Data(buf[0..<n]) }
+            let e = Darwin.errno
+            if e == EINTR { continue }
+            if e == EAGAIN || e == EWOULDBLOCK { throw NetError.timeout("recv") }
+            throw NetError.sys("recv", e)
+        }
+    }
+
+    func recvExact(_ n: Int) throws -> Data {
+        var out = Data()
+        out.reserveCapacity(n)
+        while out.count < n {
+            let c = try recv(max: n - out.count)
+            if c.isEmpty { throw NetError.closed }
+            out.append(c)
+        }
+        return out
+    }
+}
+
+/// A listening TCP socket.
+final class TCPListener {
+    let fd: Int32
+
+    init(address: String, port: Int) throws {
+        fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP)
+        if fd < 0 { throw NetError.sys("socket", Darwin.errno) }
+        var one: Int32 = 1
+        setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, socklen_t(MemoryLayout<Int32>.size))
+        var addr = sockaddr_in()
+        addr.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+        addr.sin_family = sa_family_t(AF_INET)
+        addr.sin_port = in_port_t(UInt16(port).bigEndian)
+        if inet_pton(AF_INET, address, &addr.sin_addr) != 1 { addr.sin_addr.s_addr = INADDR_ANY }
+        let rc = withUnsafePointer(to: &addr) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+                bind(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
+            }
+        }
+        if rc != 0 { let e = Darwin.errno; Darwin.close(fd); throw NetError.sys("bind \(address):\(port)", e) }
+        if listen(fd, 4) != 0 { let e = Darwin.errno; Darwin.close(fd); throw NetError.sys("listen", e) }
+    }
+
+    /// Blocks; returns nil once the listener is closed.
+    func accept() -> (TCPSocket, String)? {
+        var addr = sockaddr_in()
+        var len = socklen_t(MemoryLayout<sockaddr_in>.size)
+        let c = withUnsafeMutablePointer(to: &addr) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) { Darwin.accept(fd, $0, &len) }
+        }
+        if c < 0 { return nil }
+        var one: Int32 = 1
+        setsockopt(c, IPPROTO_TCP, TCP_NODELAY, &one, socklen_t(MemoryLayout<Int32>.size))
+        setsockopt(c, SOL_SOCKET, SO_NOSIGPIPE, &one, socklen_t(MemoryLayout<Int32>.size))
+        var ip = [CChar](repeating: 0, count: Int(INET_ADDRSTRLEN))
+        inet_ntop(AF_INET, &addr.sin_addr, &ip, socklen_t(INET_ADDRSTRLEN))
+        return (TCPSocket(fd: c), "\(String(cString: ip)):\(UInt16(bigEndian: addr.sin_port))")
+    }
+
+    func close() {
+        Darwin.shutdown(fd, SHUT_RDWR)
+        Darwin.close(fd)
+    }
+}
+
+/// QMXR/1 frame header: type, flags, little-endian length.
+enum QMXR {
+    static let hello: UInt8 = 1, iq: UInt8 = 2, cat: UInt8 = 3, ping: UInt8 = 4
+
+    static func frame(_ type: UInt8, _ payload: Data) -> Data {
+        var d = Data([type, 0, UInt8(payload.count & 0xFF), UInt8((payload.count >> 8) & 0xFF)])
+        d.append(payload)
+        return d
+    }
+
+    static func readFrame(_ s: TCPSocket) throws -> (UInt8, Data) {
+        let h = try s.recvExact(4)
+        let n = Int(h[h.startIndex + 2]) | (Int(h[h.startIndex + 3]) << 8)
+        return (h[h.startIndex], n > 0 ? try s.recvExact(n) : Data())
+    }
+}
+
+extension Data {
+    /// ASCII view for logs, shortened.
+    func logText(_ n: Int = 60) -> String {
+        let s = String(decoding: self, as: UTF8.self)
+        return s.count <= n ? s : String(s.prefix(n)) + "..."
+    }
+}
diff --git a/tools/mac-bridge-app/QMXBridge/Core/Probe.swift b/tools/mac-bridge-app/QMXBridge/Core/Probe.swift
new file mode 100644
index 00000000..4ac7a92a
--- /dev/null
+++ b/tools/mac-bridge-app/QMXBridge/Core/Probe.swift
@@ -0,0 +1,79 @@
+// Probe.swift - one-off check through the relay: read-only CAT queries
+// (ID; FA; MD;) on port 3 and the I/Q copy's hello. Never transmits.
+
+import Foundation
+
+enum Probe {
+    struct Result {
+        var lines: [String] = []
+        var passed = false
+    }
+
+    static func run(settings: BridgeSettings, requireIQ: Bool = false) -> Result {
+        var r = Result()
+        func say(_ s: String) { r.lines.append(s); logI("probe: " + s) }
+        var host = settings.fixedHost
+        if host == nil {
+            let found = Discovery.discover(udpPort: settings.discoveryPort)
+            if let f = found.first {
+                say("ok  : QMXR? -> " + found.map(\.description).joined(separator: ", "))
+                host = f.ip
+            } else if let fb = settings.fallback {
+                say("note: no relay answered QMXR?; using the fallback \(fb)")
+                host = fb
+            } else {
+                say("FAIL: no relay answered QMXR? on UDP \(settings.discoveryPort)")
+                return r
+            }
+        }
+        guard let h = host else { return r }
+        let s: TCPSocket
+        do {
+            s = try TCPSocket.connect(host: h, port: settings.port, timeout: 3)
+        } catch {
+            say("FAIL: can't reach the relay at \(h):\(settings.port): \(error)")
+            return r
+        }
+        say("ok  : connected to \(h):\(settings.port) (QMX port 3)")
+        s.setReadTimeout(3)
+        var ok = true
+        for q in ["ID;", "FA;", "MD;"] {
+            do { try s.sendAll(q) } catch { say("FAIL: send \(q): \(error)"); s.close(); return r }
+            var reply = Data()
+            let end = Date().addingTimeInterval(3)
+            while Date() < end && reply.last != UInt8(ascii: ";") {
+                do {
+                    let c = try s.recv(max: 256)
+                    if c.isEmpty {
+                        say("FAIL: the relay closed port 3 - is the QMX on, with 'USB serial ports' = 3?")
+                        s.close()
+                        return r
+                    }
+                    reply.append(c)
+                } catch { break }
+            }
+            let good = reply.last == UInt8(ascii: ";")
+            ok = ok && good
+            say("\(good ? "ok  " : "FAIL"): \(q) -> \(reply.isEmpty ? "(no reply)" : reply.logText())")
+        }
+        s.close()
+        // the listen-only I/Q copy the TCI server uses (relay port 7357)
+        do {
+            let q = try TCPSocket.connect(host: h, port: settings.iqPort, timeout: 3)
+            q.setReadTimeout(3)
+            try q.sendAll(QMXR.frame(QMXR.hello, Data("QMXR/1 probe".utf8)))
+            let (t, hello) = try QMXR.readFrame(q)
+            let txt = String(decoding: hello, as: UTF8.self)
+            let good = t == QMXR.hello && txt.contains("role=listen")
+            say("\(good ? "ok  " : "FAIL"): I/Q copy on \(h):\(settings.iqPort) -> \(txt.isEmpty ? "(no answer)" : hello.logText())")
+            if requireIQ { ok = ok && good }
+            q.close()
+        } catch {
+            say("\(requireIQ ? "FAIL" : "note"): I/Q copy on \(h):\(settings.iqPort): \(error) (the relay needs updating for TCI)")
+            if requireIQ { ok = false }
+        }
+        r.passed = ok
+        say("PROBE \(ok ? "PASSED" : "FAILED")")
+        return r
+    }
+}
diff --git a/tools/mac-bridge-app/QMXBridge/Core/PtyEndpoint.swift b/tools/mac-bridge-app/QMXBridge/Core/PtyEndpoint.swift
new file mode 100644
index 00000000..ad304b66
--- /dev/null
+++ b/tools/mac-bridge-app/QMXBridge/Core/PtyEndpoint.swift
@@ -0,0 +1,99 @@
+// PtyEndpoint.swift - a pseudo-terminal linked at a fixed path (default
+// ~/cu.QMX-NAS). Works without the driver; programs that only list /dev/cu.*
+// ports won't show it, but anything that accepts a typed path will.
+
+import Foundation
+import Darwin
+
+final class PtyEndpoint: SerialEndpoint {
+    private var master: Int32 = -1
+    private var slave: Int32 = -1
+    private let link: String
+    private var deviceName = ""
+    private var source: DispatchSourceRead?
+    private let q = DispatchQueue(label: "qmx.pty")
+
+    init(linkPath: String) {
+        link = (linkPath as NSString).expandingTildeInPath
+    }
+
+    var displayPath: String { deviceName.isEmpty ? link : "\(link)  (device \(deviceName))" }
+
+    func start(onData: @escaping (Data) -> Void, onOpen: @escaping (Bool) -> Void) throws {
+        var m: Int32 = -1, s: Int32 = -1
+        guard openpty(&m, &s, nil, nil, nil) == 0 else { throw NetError.sys("openpty", errno) }
+        master = m; slave = s
+        // Raw 8-bit, no echo: an echo would send the radio's replies back to it.
+        var t = termios()
+        tcgetattr(slave, &t)
+        cfmakeraw(&t)
+        t.c_lflag &= ~tcflag_t(ECHO | ECHONL)
+        tcsetattr(slave, TCSANOW, &t)
+        _ = fcntl(master, F_SETFL, fcntl(master, F_GETFL) | O_NONBLOCK)
+        deviceName = String(cString: ttyname(slave))
+        // We keep our own handle on the device open (and never read it), so the
+        // device stays put while programs open and close it.
+        let dir = (link as NSString).deletingLastPathComponent
+        try? FileManager.default.createDirectory(atPath: dir, withIntermediateDirectories: true)
+        let tmp = "\(link).\(getpid()).tmp"
+        unlink(tmp)
+        guard symlink(deviceName, tmp) == 0 else { throw NetError.sys("symlink \(tmp)", errno) }
+        guard rename(tmp, link) == 0 else { let e = errno; unlink(tmp); throw NetError.sys("rename to \(link)", e) }
+
+        let src = DispatchSource.makeReadSource(fileDescriptor: master, queue: q)
+        src.setEventHandler { [weak self] in
+            guard let self = self else { return }
+            var buf = [UInt8](repeating: 0, count: 4096)
+            let n = read(self.master, &buf, buf.count)
+            if n > 0 {
+                onData(Data(buf[0..<n]))
+            } else if n < 0 && errno == EIO {
+                usleep(50_000)          // no program has the port open
+            }
+        }
+        src.resume()
+        source = src
+    }
+
+    /// Programs may change the port settings; never allow echo, which would
+    /// loop the radio's replies straight back into the radio.
+    private func noEcho() {
+        var t = termios()
+        guard tcgetattr(slave, &t) == 0 else { return }
+        let bad = tcflag_t(ECHO | ECHONL)
+        if t.c_lflag & bad != 0 {
+            t.c_lflag &= ~bad
+            tcsetattr(slave, TCSANOW, &t)
+            logI("turned echo off on the serial port")
+        }
+    }
+
+    func write(_ data: Data) {
+        noEcho()
+        data.withUnsafeBytes { (raw: UnsafeRawBufferPointer) in
+            guard var p = raw.baseAddress else { return }
+            var left = raw.count
+            while left > 0 {
+                let n = Darwin.write(master, p, left)
+                if n < 0 {
+                    if errno == EAGAIN { logW("serial port full (nothing reading it): dropped \(left) bytes") }
+                    else { logW("serial port write failed: \(String(cString: strerror(errno)))") }
+                    return
+                }
+                p += n; left -= n
+            }
+        }
+    }
+
+    func flushStale() { tcflush(slave, TCIFLUSH) }
+
+    func stop() {
+        source?.cancel()
+        source = nil
+        var target = [CChar](repeating: 0, count: 1024)
+        let n = readlink(link, &target, 1023)
+        if n > 0 && String(cString: target) == deviceName { unlink(link) }
+        if slave >= 0 { close(slave); slave = -1 }
+        if master >= 0 { close(master); master = -1 }
+    }
+}
diff --git a/tools/mac-bridge-app/QMXBridge/Core/SerialBridge.swift b/tools/mac-bridge-app/QMXBridge/Core/SerialBridge.swift
new file mode 100644
index 00000000..ba00edc3
--- /dev/null
+++ b/tools/mac-bridge-app/QMXBridge/Core/SerialBridge.swift
@@ -0,0 +1,193 @@
+// SerialBridge.swift - the QMX on the NAS as a serial port on this Mac.
+//
+//   QMX --USB--> NAS relay --TCP 7356 (QMX serial port 3, raw bytes)--> this app
+//       --> a serial device on the Mac: the QMX Bridge virtual USB serial port
+//           (DriverKit driver), or a pseudo-terminal linked at ~/cu.QMX-NAS.
+//
+// Same behaviour as qmx_serial_bridge.py: connects to the relay only when a
+// program talks to the port, releases it after `idle` seconds of silence, drops
+// commands (and retries) while the radio is unreachable, bytes pass unchanged.
+
+import Foundation
+
+/// The Mac side of the bridge: something programs open as a serial port.
+protocol SerialEndpoint: AnyObject {
+    /// Human-readable path, e.g. /dev/cu.QMX-NAS or ~/cu.QMX-NAS -> /dev/ttys012
+    var displayPath: String { get }
+    /// Start delivering what programs write (onData) and open/close events.
+    func start(onData: @escaping (Data) -> Void, onOpen: @escaping (Bool) -> Void) throws
+    /// Bytes from the radio, for the program.
+    func write(_ data: Data)
+    /// Throw away radio bytes no program has read yet.
+    func flushStale()
+    func stop()
+}
+
+final class SerialBridge {
+    static let connectTimeout = 3.0
+    static let retryAfter = 3.0
+    static let quickClose = 1.5
+
+    let settings: BridgeSettings
+    let endpoint: SerialEndpoint
+    let locator: RelayLocator
+    private let q = DispatchQueue(label: "qmx.serial-bridge")
+    private var sock: TCPSocket?
+    private var connectedAt = Date.distantPast
+    private var gotReply = false
+    private var lastTraffic = Date.distantPast
+    private var retryAt = Date.distantPast
+    private var droppedNote = Date.distantPast
+    private var timer: DispatchSourceTimer?
+    private(set) var running = false
+
+    /// Called on the main queue when the relay connection changes.
+    var onState: ((_ relayConnected: Bool, _ host: String?) -> Void)?
+
+    init(settings: BridgeSettings, endpoint: SerialEndpoint) {
+        self.settings = settings
+        self.endpoint = endpoint
+        self.locator = RelayLocator(settings: settings)
+    }
+
+    func start() throws {
+        try endpoint.start(onData: { [weak self] d in self?.onPortData(d) },
+                           onOpen: { [weak self] open in self?.onPortOpen(open) })
+        running = true
+        logI("serial port ready: \(endpoint.displayPath)")
+        q.async {
+            if self.locator.searching { self.locator.find() }
+            let mode = self.settings.keepConnected ? "kept connected"
+                : self.settings.idle > 0 ? "connects on demand, releases after \(self.settings.idle)s idle"
+                : "connects on demand, stays connected"
+            logI("relay: \(self.locator.host ?? "(not found yet)"):\(self.settings.port)   \(mode)")
+            self.notify()
+        }
+        let t = DispatchSource.makeTimerSource(queue: q)
+        t.schedule(deadline: .now() + 1, repeating: 1)
+        t.setEventHandler { [weak self] in self?.tick() }
+        t.resume()
+        timer = t
+    }
+
+    func stop() {
+        running = false
+        timer?.cancel()
+        timer = nil
+        q.sync { disconnect("stopping") }
+        endpoint.stop()
+    }
+
+    private func notify() {
+        let c = sock != nil, h = locator.host
+        DispatchQueue.main.async { self.onState?(c, h) }
+    }
+
+    // MARK: - relay
+
+    private func connect() -> Bool {
+        if locator.host == nil && !(locator.searching && locator.find()) {
+            retryAt = Date().addingTimeInterval(Self.retryAfter)
+            return false
+        }
+        guard let host = locator.host else { return false }
+        do {
+            let s = try TCPSocket.connect(host: host, port: settings.port, timeout: Self.connectTimeout)
+            sock = s
+            connectedAt = Date(); lastTraffic = connectedAt
+            gotReply = false
+            endpoint.flushStale()
+            logI("connected to the relay \(host):\(settings.port) (QMX serial port 3)")
+            let th = Thread { [weak self] in self?.reader(s) }
+            th.name = "relay-rx"
+            th.start()
+            notify()
+            return true
+        } catch {
+            logW("can't reach the relay at \(host):\(settings.port): \(error)")
+            if let e = (error as? NetError)?.errno, e == EHOSTUNREACH || e == ENETUNREACH || e == EPERM {
+                logW("if this Mac is on the NAS's network, check System Settings -> Privacy & Security -> Local Network allows QMX Bridge")
+            }
+            let old = locator.host
+            if locator.searching && locator.find() && locator.host != old {
+                return connect()      // the NAS moved: try its new address once
+            }
+            retryAt = Date().addingTimeInterval(Self.retryAfter)
+            return false
+        }
+    }
+
+    private func disconnect(_ why: String) {
+        if let s = sock {
+            s.close()
+            sock = nil
+            logI("released the relay: \(why)")
+            notify()
+        }
+    }
+
+    private func reader(_ s: TCPSocket) {
+        var why = "relay closed the connection (QMX off or relay restarted)"
+        while true {
+            do {
+                let d = try s.recv(max: 4096)
+                if d.isEmpty { break }
+                q.async { if self.sock === s { self.gotReply = true; self.lastTraffic = Date() } }
+                logD("radio -> port: \(d.logText())")
+                endpoint.write(d)
+            } catch {
+                why = "connection lost: \(error)"
+                break
+            }
+        }
+        q.async {
+            guard self.sock === s else { return }
+            if !self.quickCloseCheck() { self.disconnect(why) }
+        }
+    }
+
+    /// The relay drops port 3 at once when the radio can't serve it.
+    private func quickCloseCheck() -> Bool {
+        if !gotReply && Date().timeIntervalSince(connectedAt) < Self.quickClose {
+            logW("the relay closed port 3 straight away. Is the QMX on, and is 'USB serial ports' set to 3 on the radio? (see the relay's log)")
+            retryAt = Date().addingTimeInterval(Self.retryAfter)
+            disconnect("port 3 refused")
+            return true
+        }
+        return false
+    }
+
+    // MARK: - port side
+
+    private func onPortData(_ d: Data) {
+        q.async {
+            logD("port -> radio: \(d.logText())")
+            let now = Date()
+            if self.sock == nil {
+                if now < self.retryAt || !self.connect() {
+                    if now.timeIntervalSince(self.droppedNote) > 30 {
+                        logI("radio not reachable: dropping commands (retrying)")
+                        self.droppedNote = now
+                    }
+                    return
+                }
+            }
+            self.lastTraffic = now
+            do { try self.sock?.sendAll(d) } catch { self.disconnect("send failed: \(error)") }
+        }
+    }
+
+    private func onPortOpen(_ open: Bool) {
+        logI(open ? "a program opened the serial port" : "the program closed the serial port")
+    }
+
+    private func tick() {
+        let now = Date()
+        if settings.keepConnected && sock == nil && now >= retryAt { _ = connect() }
+        if sock != nil && settings.idle > 0 && !settings.keepConnected &&
+            now.timeIntervalSince(lastTraffic) > Double(settings.idle) {
+            disconnect("idle for \(settings.idle)s")
+            endpoint.flushStale()
+        }
+    }
+}
diff --git a/tools/mac-bridge-app/QMXBridge/Driver/DriverEndpoint.swift b/tools/mac-bridge-app/QMXBridge/Driver/DriverEndpoint.swift
new file mode 100644
index 00000000..8142aa85
--- /dev/null
+++ b/tools/mac-bridge-app/QMXBridge/Driver/DriverEndpoint.swift
@@ -0,0 +1,175 @@
+// DriverEndpoint.swift - the virtual USB serial port (QMXSerialDriver.dext) as
+// the bridge's serial endpoint: programs open /dev/cu.QMX-NAS like any USB
+// serial adapter; this side talks to the driver through its user client.
+
+import Foundation
+import IOKit
+import IOKit.serial
+
+final class DriverEndpoint: SerialEndpoint {
+    enum DriverError: Error, CustomStringConvertible {
+        case notInstalled, open(kern_return_t), notify(kern_return_t)
+        var description: String {
+            switch self {
+            case .notInstalled: return "the QMX serial driver is not running (install it from the Driver tab)"
+            case .open(let r): return "can't open the QMX serial driver (IOServiceOpen 0x\(String(UInt32(bitPattern: r), radix: 16)))"
+            case .notify(let r): return "the QMX serial driver refused notifications (0x\(String(UInt32(bitPattern: r), radix: 16)))"
+            }
+        }
+    }
+
+    struct Status {
+        var portReady = false, open = false, queues = false
+        var rxSize = 0, txSize = 0, rxDropped = 0, baud = 0, ringMode = 0
+    }
+
+    private var service: io_service_t = 0
+    private var connect: io_connect_t = 0
+    private var notifyPort: IONotificationPortRef?
+    private let q = DispatchQueue(label: "qmx.driver")
+    private var onData: ((Data) -> Void)?
+    private var onOpen: ((Bool) -> Void)?
+    private var asyncRef = [io_user_reference_t](repeating: 0, count: Int(kOSAsyncRef64Count))
+
+    var displayPath: String { Self.calloutPath() ?? "/dev/cu.\(kQMXSerialTTYBaseName)" }
+
+    /// The /dev/cu.* path the serial family gave our port, if it exists.
+    static func calloutPath() -> String? {
+        guard let match = IOServiceMatching(kIOSerialBSDServiceValue) else { return nil }
+        var it: io_iterator_t = 0
+        guard IOServiceGetMatchingServices(kIOMainPortDefault, match, &it) == KERN_SUCCESS else { return nil }
+        defer { IOObjectRelease(it) }
+        var found: String?
+        while case let s = IOIteratorNext(it), s != 0 {
+            defer { IOObjectRelease(s) }
+            if let p = IORegistryEntryCreateCFProperty(s, kIOCalloutDeviceKey as CFString, kCFAllocatorDefault, 0)?
+                .takeRetainedValue() as? String, p.contains(kQMXSerialTTYBaseName) {
+                found = p
+            }
+        }
+        return found
+    }
+
+    static func controlService() -> io_service_t {
+        let match: NSDictionary = [kIOPropertyMatchKey: ["IOUserClass": kQMXBridgeControlClass]]
+        return IOServiceGetMatchingService(kIOMainPortDefault, match as CFDictionary)
+    }
+
+    static var isDriverRunning: Bool {
+        let s = controlService()
+        if s != 0 { IOObjectRelease(s); return true }
+        return false
+    }
+
+    func start(onData: @escaping (Data) -> Void, onOpen: @escaping (Bool) -> Void) throws {
+        self.onData = onData
+        self.onOpen = onOpen
+        service = Self.controlService()
+        guard service != 0 else { throw DriverError.notInstalled }
+        let r = IOServiceOpen(service, mach_task_self_, UInt32(kQMXBridgeUserClientType), &connect)
+        guard r == KERN_SUCCESS else { IOObjectRelease(service); service = 0; throw DriverError.open(r) }
+
+        guard let port = IONotificationPortCreate(kIOMainPortDefault) else { throw DriverError.notify(kIOReturnNoMemory) }
+        notifyPort = port
+        IONotificationPortSetDispatchQueue(port, q)
+        let callback: IOAsyncCallback = { refcon, result, args, numArgs in
+            guard let refcon = refcon else { return }
+            let me = Unmanaged<DriverEndpoint>.fromOpaque(refcon).takeUnretainedValue()
+            var vals: [UInt64] = []
+            if let a = args {
+                for i in 0..<Int(numArgs) { vals.append(UInt64(UInt(bitPattern: a[i]))) }
+            }
+            me.event(vals)
+        }
+        asyncRef[Int(kIOAsyncCalloutFuncIndex)] = io_user_reference_t(UInt(bitPattern: unsafeBitCast(callback, to: UnsafeRawPointer.self)))
+        asyncRef[Int(kIOAsyncCalloutRefconIndex)] = io_user_reference_t(UInt(bitPattern: Unmanaged.passUnretained(self).toOpaque()))
+        var outCnt: UInt32 = 0
+        let nr = IOConnectCallAsyncScalarMethod(connect, UInt32(kQMXMethodNotify), IONotificationPortGetMachPort(port),
+                                                &asyncRef, UInt32(kOSAsyncRef64Count), nil, 0, nil, &outCnt)
+        guard nr == KERN_SUCCESS else { throw DriverError.notify(nr) }
+        let st = status()
+        if st.open { onOpen(true) }
+        q.async { self.drain() }       // anything written before we connected
+    }
+
+    private func event(_ v: [UInt64]) {
+        guard let e = v.first else { return }
+        switch Int(e) {
+        case kQMXEventTxData: drain()
+        case kQMXEventOpen: onOpen?(true)
+        case kQMXEventClose: onOpen?(false)
+        case kQMXEventMCR: logD("port: DTR \(v.count > 1 && v[1] & 1 != 0 ? "on" : "off"), RTS \(v.count > 1 && v[1] & 2 != 0 ? "on" : "off")")
+        case kQMXEventQueues: logD("port: rings \(v.count > 1 && v[1] != 0 ? "connected" : "disconnected")")
+        default: break
+        }
+    }
+
+    /// Pull everything the program wrote.
+    private func drain() {
+        guard connect != 0 else { return }
+        var buf = [UInt8](repeating: 0, count: 4096)
+        while true {
+            var size = buf.count
+            let r = IOConnectCallStructMethod(connect, UInt32(kQMXMethodRead), nil, 0, &buf, &size)
+            if r != KERN_SUCCESS || size == 0 { break }
+            onData?(Data(buf[0..<size]))
+        }
+    }
+
+    func write(_ data: Data) {
+        guard connect != 0 else { return }
+        var off = 0
+        while off < data.count {
+            let chunk = data.subdata(in: off..<min(off + 4096, data.count))
+            var accepted: UInt64 = 0
+            var outCnt: UInt32 = 1
+            let r = chunk.withUnsafeBytes { p in
+                IOConnectCallMethod(connect, UInt32(kQMXMethodWrite), nil, 0, p.baseAddress, chunk.count,
+                                    &accepted, &outCnt, nil, nil)
+            }
+            if r != KERN_SUCCESS {
+                logW("serial driver write failed (0x\(String(UInt32(bitPattern: r), radix: 16)))")
+                return
+            }
+            if Int(accepted) < chunk.count {
+                logW("serial port full or closed (nothing reading it): dropped \(chunk.count - Int(accepted)) bytes")
+                return
+            }
+            off += chunk.count
+        }
+    }
+
+    func flushStale() {
+        guard connect != 0 else { return }
+        _ = IOConnectCallScalarMethod(connect, UInt32(kQMXMethodFlushRx), nil, 0, nil, nil)
+    }
+
+    func setRingMode(_ mode: Int) {
+        guard connect != 0 else { return }
+        var v = UInt64(mode)
+        _ = IOConnectCallScalarMethod(connect, UInt32(kQMXMethodSetRingMode), &v, 1, nil, nil)
+    }
+
+    func status() -> Status {
+        var s = Status()
+        guard connect != 0 else { return s }
+        var out = [UInt64](repeating: 0, count: Int(kQMXStatCount))
+        var n = UInt32(kQMXStatCount)
+        guard IOConnectCallScalarMethod(connect, UInt32(kQMXMethodStatus), nil, 0, &out, &n) == KERN_SUCCESS else { return s }
+        s.portReady = out[Int(kQMXStatPortReady)] != 0
+        s.open = out[Int(kQMXStatOpen)] != 0
+        s.queues = out[Int(kQMXStatQueues)] != 0
+        s.rxSize = Int(out[Int(kQMXStatRxSize)])
+        s.txSize = Int(out[Int(kQMXStatTxSize)])
+        s.rxDropped = Int(out[Int(kQMXStatRxDropped)])
+        s.baud = Int(out[Int(kQMXStatBaud)])
+        s.ringMode = Int(out[Int(kQMXStatRingMode)])
+        return s
+    }
+
+    func stop() {
+        if connect != 0 { IOServiceClose(connect); connect = 0 }
+        if let p = notifyPort { IONotificationPortDestroy(p); notifyPort = nil }
+        if service != 0 { IOObjectRelease(service); service = 0 }
+    }
+}
diff --git a/tools/mac-bridge-app/QMXBridge/Driver/DriverInstaller.swift b/tools/mac-bridge-app/QMXBridge/Driver/DriverInstaller.swift
new file mode 100644
index 00000000..8e243591
--- /dev/null
+++ b/tools/mac-bridge-app/QMXBridge/Driver/DriverInstaller.swift
@@ -0,0 +1,87 @@
+// DriverInstaller.swift - install / remove the QMX serial driver
+// (a DriverKit system extension embedded in the app).
+
+import Foundation
+import SystemExtensions
+
+final class DriverInstaller: NSObject, ObservableObject, OSSystemExtensionRequestDelegate {
+    static let dextIdentifier = "com.qmx.panadapter.bridge.serialdriver"
+
+    enum State: Equatable {
+        case unknown, notInstalled, waitingForApproval, installing, installed, removing, failed(String)
+    }
+
+    @Published var state: State = .unknown
+
+    func refresh() {
+        state = DriverEndpoint.isDriverRunning ? .installed : (state == .waitingForApproval ? state : .notInstalled)
+    }
+
+    func install() {
+        state = .installing
+        logI("driver: asking macOS to install \(Self.dextIdentifier)")
+        let r = OSSystemExtensionRequest.activationRequest(forExtensionWithIdentifier: Self.dextIdentifier, queue: .main)
+        r.delegate = self
+        OSSystemExtensionManager.shared.submitRequest(r)
+    }
+
+    func uninstall() {
+        state = .removing
+        logI("driver: asking macOS to remove \(Self.dextIdentifier)")
+        let r = OSSystemExtensionRequest.deactivationRequest(forExtensionWithIdentifier: Self.dextIdentifier, queue: .main)
+        r.delegate = self
+        OSSystemExtensionManager.shared.submitRequest(r)
+    }
+
+    // MARK: OSSystemExtensionRequestDelegate
+
+    func request(_ request: OSSystemExtensionRequest,
+                 actionForReplacingExtension existing: OSSystemExtensionProperties,
+                 withExtension ext: OSSystemExtensionProperties) -> OSSystemExtensionRequest.ReplacementAction {
+        logI("driver: replacing version \(existing.bundleShortVersion) (\(existing.bundleVersion)) with \(ext.bundleShortVersion) (\(ext.bundleVersion))")
+        return .replace
+    }
+
+    func requestNeedsUserApproval(_ request: OSSystemExtensionRequest) {
+        logW("driver: approve it in System Settings -> General -> Login Items & Extensions -> Driver Extensions (or Privacy & Security), then come back")
+        state = .waitingForApproval
+    }
+
+    func request(_ request: OSSystemExtensionRequest, didFinishWithResult result: OSSystemExtensionRequest.Result) {
+        switch result {
+        case .completed:
+            logI("driver: done")
+        case .willCompleteAfterReboot:
+            logW("driver: macOS will finish this after a restart")
+        @unknown default:
+            logI("driver: finished (\(result.rawValue))")
+        }
+        if state == .removing {
+            state = .notInstalled
+        } else {
+            // the driver's services appear a moment after activation
+            DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) { self.refresh() }
+            state = .installed
+        }
+    }
+
+    func request(_ request: OSSystemExtensionRequest, didFailWithError error: Error) {
+        let e = error as NSError
+        var why = e.localizedDescription
+        if e.domain == OSSystemExtensionErrorDomain, let code = OSSystemExtensionError.Code(rawValue: e.code) {
+            switch code {
+            case .unsupportedParentBundleLocation:
+                why = "move QMX Bridge.app to /Applications first (or turn on 'systemextensionsctl developer on')"
+            case .missingEntitlement:
+                why = "the app or driver is missing a DriverKit entitlement - see tools/mac-bridge-app/README.md"
+            case .codeSignatureInvalid, .validationFailed:
+                why = "macOS rejected the driver's signature - see README.md (development signing needs SIP relaxed and 'systemextensionsctl developer on')"
+            case .requestCanceled:
+                why = "cancelled"
+            default: break
+            }
+        }
+        logE("driver: \(why) [\(e.domain) \(e.code)]")
+        state = .failed(why)
+    }
+}
