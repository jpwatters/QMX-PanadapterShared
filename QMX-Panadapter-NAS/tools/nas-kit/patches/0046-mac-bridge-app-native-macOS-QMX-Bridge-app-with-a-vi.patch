diff --git a/tools/mac-bridge-app/QMXSerialDriver/QMXSerialDriver.iig b/tools/mac-bridge-app/QMXSerialDriver/QMXSerialDriver.iig
new file mode 100644
index 00000000..beb313b2
--- /dev/null
+++ b/tools/mac-bridge-app/QMXSerialDriver/QMXSerialDriver.iig
@@ -0,0 +1,58 @@
+// QMXSerialDriver.iig - a virtual serial port (no hardware): what programs
+// write goes to the QMX Bridge app, what the app hands in is what programs read.
+
+#ifndef QMXSerialDriver_h
+#define QMXSerialDriver_h
+
+#include <Availability.h>
+#include <DriverKit/IOService.iig>
+#include <SerialDriverKit/IOUserSerial.iig>
+
+class QMXSerialDriver : public IOUserSerial
+{
+public:
+    virtual bool init() override;
+    virtual void free() override;
+
+    virtual kern_return_t Start(IOService * provider) override;
+    virtual kern_return_t Stop(IOService * provider) override;
+
+    virtual kern_return_t ConnectQueues(IOBufferMemoryDescriptor ** ifmd,
+                                        IOMemoryDescriptor ** rxqmd,
+                                        IOMemoryDescriptor ** txqmd,
+                                        IOMemoryDescriptor * in_rxqmd,
+                                        IOMemoryDescriptor * in_txqmd,
+                                        uint32_t in_rxqoffset,
+                                        uint32_t in_txqoffset,
+                                        uint8_t in_rxqlogsz,
+                                        uint8_t in_txqlogsz) override;
+    virtual kern_return_t DisconnectQueues() override;
+
+    virtual void RxFreeSpaceAvailable() override;
+    virtual void TxDataAvailable() override;
+
+    virtual kern_return_t HwActivate() override;
+    virtual kern_return_t HwDeactivate() override;
+    virtual kern_return_t HwResetFIFO(bool tx, bool rx) override;
+    virtual kern_return_t HwSendBreak(bool sendBreak) override;
+    virtual kern_return_t HwProgramUART(uint32_t baudRate, uint8_t nDataBits,
+                                        uint8_t nHalfStopBits, uint8_t parity) override;
+    virtual kern_return_t HwProgramBaudRate(uint32_t baudRate) override;
+    virtual kern_return_t HwProgramMCR(bool dtr, bool rts) override;
+    virtual kern_return_t HwGetModemStatus(bool * cts, bool * dsr, bool * ri, bool * dcd) override;
+    virtual kern_return_t HwProgramLatencyTimer(uint32_t latency) override;
+    virtual kern_return_t HwProgramFlowControl(uint32_t arg, uint8_t xon, uint8_t xoff) override;
+
+    // ---- used by QMXBridgeUserClient (same process) ----
+    // Radio bytes for the program; returns how many were accepted.
+    uint32_t PushRx(const uint8_t * data, uint32_t len) LOCALONLY;
+    // Bytes the program wrote; returns how many were copied out.
+    uint32_t PullTx(uint8_t * out, uint32_t max) LOCALONLY;
+    void FlushRx() LOCALONLY;
+    void SetRingMode(uint32_t mode) LOCALONLY;
+    void GetStatus(uint64_t * out, uint32_t count) LOCALONLY;
+    void SetListener(OSObject * client) LOCALONLY;
+    void SendEvent(uint64_t event, uint64_t value) LOCALONLY;
+};
+
+#endif /* QMXSerialDriver_h */
diff --git a/tools/mac-bridge-app/README.md b/tools/mac-bridge-app/README.md
new file mode 100644
index 00000000..eff5a513
--- /dev/null
+++ b/tools/mac-bridge-app/README.md
@@ -0,0 +1,120 @@
+# QMX Bridge for macOS
+
+A native Mac app (Swift/SwiftUI) that replaces `tools/mac-serial-bridge` (Python). It
+does everything the Python bridge did, in one window:
+
+| Tab | What it does |
+|---|---|
+| **Relay** | **Discover** sends `QMXR?` on UDP 7355 and lists the relays that answer. **Probe** runs read-only checks: `ID;` `FA;` `MD;` on port 3, plus the I/Q copy's hello on TCP 7357. |
+| **Serial Port** | Makes QMX serial port 3 (relay TCP 7356) a serial port on this Mac. It connects only while a program talks to the port and releases the port after 120 s idle. |
+| **TCI** | A TCI server at `ws://127.0.0.1:40001` for WS, WSJT-X 3 and JTDX. Receive audio is demodulated from the I/Q copy; transmit sends one tone at a time as `TA<Hz>;`. |
+| **Driver** | Installs or removes the virtual USB serial port driver. |
+| **Settings** | Fixed or fallback NAS address, ports, idle time, TCI address, verbose log. |
+
+The serial port and the TCI server both use the radio's port 3, so only one runs at a time.
+
+## Two kinds of serial port
+
+1. **Virtual USB serial port (driver).** `QMXSerialDriver.dext` is a DriverKit
+   `IOUserSerial` driver. With it, the QMX appears as **`/dev/cu.QMX-NAS`**, exactly like a
+   USB serial adapter, so it shows up in every program's port list (WSJT-X, fldigi, CHIRP,
+   loggers, `screen`). The driver has no hardware: what programs write goes to the app, which
+   forwards it to the relay, and the radio's replies come back the same way.
+2. **Pseudo-terminal link (no driver).** This works the same way as the Python bridge: a pty
+   linked at `~/cu.QMX-NAS`. It needs no driver or special signing, but programs that only
+   list `/dev/cu.*` won't show it, so you type the path instead. **QMX Bridge Lite.app** is the
+   build that has only this mode.
+
+## Building
+
+You need Xcode with the DriverKit SDK; Xcode 15 or later includes it.
+[XcodeGen](https://github.com/yonaskolb/XcodeGen) is downloaded automatically if it is
+missing.
+
+```bash
+cd ~/src/QMX-Panadapter-NAS/tools/mac-bridge-app
+./build.sh                    # both apps, signed to run locally
+./build.sh --lite             # only QMX Bridge Lite.app
+./build.sh --team ABCDE12345  # sign with your Apple developer team
+./build.sh --install          # also copy to /Applications
+```
+
+The apps go to `build/out/`. The log goes to `build/build.log` and, if `~/Claude` exists,
+also to `~/Claude/mac-bridge-build.log`.
+
+To work in Xcode instead, run `xcodegen` in this folder and open `QMXBridge.xcodeproj`.
+
+## Running the driver: signing and approval
+
+macOS loads a driver extension only when it is signed with the DriverKit entitlements the
+driver uses:
+
+- `com.apple.developer.driverkit`
+- `com.apple.developer.driverkit.family.serial`
+- `com.apple.developer.driverkit.allow-third-party-userclients`
+
+The app needs two more:
+
+- `com.apple.developer.system-extension.install`
+- `com.apple.developer.driverkit.userclient-access`
+
+Apple grants the DriverKit ones per developer team, on request. Until Apple grants them, run
+the driver in **development mode**:
+
+1. Restart into Recovery: hold the power button on Apple silicon, or Cmd-R on Intel. Open
+   Terminal there and run `csrutil disable`, then restart.
+2. In Terminal, run `systemextensionsctl developer on`.
+3. Build with `./build.sh --install`, open **/Applications/QMX Bridge.app**, go to
+   **Driver**, then click **Install / Update**.
+4. Approve the extension. On macOS 15 or later: System Settings → General → Login Items &
+   Extensions → Driver Extensions. On older macOS: Privacy & Security → Allow.
+5. Check the driver is loaded: `systemextensionsctl list` shows
+   `com.qmx.panadapter.bridge.serialdriver [activated enabled]`. Then start **Serial Port**,
+   and `ls /dev/cu.*` shows `cu.QMX-NAS`.
+
+If macOS still rejects an ad-hoc-signed driver ("invalid signature" or "missing
+entitlement" in the Driver tab or in Console), also run
+`sudo nvram boot-args="amfi_get_out_of_my_way=0x1"` and restart. To undo it, run
+`sudo nvram -d boot-args`. Turn SIP back on with `csrutil enable` from Recovery when you are
+done.
+
+### Asking Apple for the entitlements
+
+At developer.apple.com → Account → **Request DriverKit entitlements**:
+
+> **Driver:** QMX Bridge virtual serial port (`com.qmx.panadapter.bridge.serialdriver`), an
+> `IOUserSerial` driver matching `IOUserResources`.
+>
+> **Purpose:** Amateur radio. A QRP Labs QMX transceiver is plugged into a NAS on the home
+> network. The companion app connects to the NAS over TCP and presents the radio's CAT
+> serial port on the Mac as a normal serial device, so that existing ham-radio software
+> (WSJT-X, fldigi, Hamlib, loggers) can use it unchanged.
+>
+> **Entitlements:**
+> - `com.apple.developer.driverkit`
+> - `com.apple.developer.driverkit.family.serial`
+> - `com.apple.developer.driverkit.allow-third-party-userclients` (for the dext)
+> - `com.apple.developer.driverkit.userclient-access` (for the app, `com.qmx.panadapter.bridge`)
+> - `com.apple.developer.system-extension.install` (for the app)
+
+Once Apple grants them, build with `./build.sh --team <your team ID> --install`. SIP can stay
+on.
+
+## Using it
+
+- **Serial Port:** in WSJT-X, Rig is QRP Labs QMX (or Kenwood TS-480), and Serial Port is
+  `/dev/cu.QMX-NAS` (driver) or `~/cu.QMX-NAS` (pty). Any baud rate works.
+- **TCI:** in WS or WSJT-X, Settings → Radio → Rig is **TCI Client RX1** and Network Server is
+  `127.0.0.1:40001`. Audio comes over TCI.
+- Allow **Local Network** access when macOS asks, or later in System Settings → Privacy &
+  Security → Local Network → QMX Bridge.
+
+## How the driver works
+
+| Piece | Role |
+|---|---|
+| `QMXSerialDriver` (`IOUserSerial`) | Implements the serial family's hardware calls with no hardware. The kernel shares two rings with it, through the `SerialPortInterface` indices. The **tx ring** holds what programs wrote: on `TxDataAvailable` the driver signals the app, the app pulls the bytes (`kQMXMethodRead`), and the driver advances `txCI` and calls `TxFreeSpaceAvailable`. The **rx ring** carries the radio's bytes: the app pushes them (`kQMXMethodWrite`), the driver copies them in, advances `rxPI` and calls `RxDataAvailable`. CTS, DSR and DCD always read as on. |
+| `QMXBridgeControl` and `QMXBridgeUserClient` | A separate service the app opens, user client type `'QMX'`. It carries the read and write methods, a status method, and an async notification for "data written", "port opened", "port closed" and DTR/RTS changes. See `Shared/QMXBridgeShared.h`. |
+| Ring index mode | Apple doesn't document whether the ring indices run free or wrap at the ring size. The driver assumes free-running and switches to it by itself when it sees an index larger than the ring. If replies stop after about 16 KB of traffic, try **Wrapped** in the Driver tab. |
+
+Driver log: `log stream --predicate 'eventMessage CONTAINS "QMXSerialDriver" OR eventMessage CONTAINS "QMXBridge"'`.
diff --git a/tools/mac-bridge-app/Shared/QMXBridgeShared.h b/tools/mac-bridge-app/Shared/QMXBridgeShared.h
new file mode 100644
index 00000000..7edb78cc
--- /dev/null
+++ b/tools/mac-bridge-app/Shared/QMXBridgeShared.h
@@ -0,0 +1,56 @@
+// QMXBridgeShared.h - the contract between the QMX Bridge app and its driver
+// (QMXSerialDriver.dext). Included by the dext (C++) and the app (Swift, via
+// the bridging header).
+
+#ifndef QMXBridgeShared_h
+#define QMXBridgeShared_h
+
+#include <stdint.h>
+
+// IOService class name the app looks up, and the user client type it opens.
+#define kQMXBridgeControlClass   "QMXBridgeControl"
+#define kQMXBridgeUserClientType 0x514D58u            // 'QMX'
+
+// The BSD name programs see: /dev/cu.<IOTTYBaseName><IOTTYSuffix>
+#define kQMXSerialTTYBaseName    "QMX-NAS"
+
+// External methods on the user client.
+enum {
+    // structure input: bytes from the radio, delivered to the program reading the port (<= 4096)
+    kQMXMethodWrite      = 0,
+    // structure output: bytes the program wrote to the port (<= 4096); empty = none waiting
+    kQMXMethodRead       = 1,
+    // async: register for notifications (completion args below); no input
+    kQMXMethodNotify     = 2,
+    // scalar output[0..7]: state, see kQMXStat*
+    kQMXMethodStatus     = 3,
+    // scalar input[0]: ring index mode (0 = free running, 1 = wrapped at ring size)
+    kQMXMethodSetRingMode = 4,
+    // no input: throw away radio bytes not yet read by the program
+    kQMXMethodFlushRx    = 5,
+    kQMXMethodCount
+};
+
+// Async completion argument 0: what happened. Argument 1: a value.
+enum {
+    kQMXEventTxData  = 1,   // the program wrote bytes: call kQMXMethodRead until it returns none
+    kQMXEventOpen    = 2,   // a program opened the port (HwActivate)
+    kQMXEventClose   = 3,   // the port was closed (HwDeactivate)
+    kQMXEventMCR     = 4,   // DTR/RTS changed: value bit0 = DTR, bit1 = RTS
+    kQMXEventQueues  = 5,   // ring buffers connected (value 1) or disconnected (value 0)
+};
+
+// kQMXMethodStatus outputs
+enum {
+    kQMXStatPortReady = 0,  // 1 = the serial driver instance exists
+    kQMXStatOpen      = 1,  // 1 = a program has the port open
+    kQMXStatQueues    = 2,  // 1 = rings connected
+    kQMXStatRxSize    = 3,  // rx ring size (bytes)
+    kQMXStatTxSize    = 4,
+    kQMXStatRxDropped = 5,  // radio bytes dropped because the program did not read them
+    kQMXStatBaud      = 6,  // last baud rate the program set (ignored)
+    kQMXStatRingMode  = 7,
+    kQMXStatCount     = 8
+};
+
+#endif /* QMXBridgeShared_h */
diff --git a/tools/mac-bridge-app/build.sh b/tools/mac-bridge-app/build.sh
new file mode 100755
index 00000000..a9d72b15
--- /dev/null
+++ b/tools/mac-bridge-app/build.sh
@@ -0,0 +1,118 @@
+#!/bin/bash
+# build.sh - build QMX Bridge.app (with its virtual serial port driver) and/or
+# QMX Bridge Lite.app (no driver) from this folder.
+#
+#   ./build.sh                       # both apps, signed to run locally (ad-hoc)
+#   ./build.sh --team ABCDE12345     # both apps, signed with your Apple developer team
+#   ./build.sh --lite                # only QMX Bridge Lite.app (no driver, no special signing)
+#   ./build.sh --xcode /Applications/Xcode-27.app
+#   ./build.sh --install             # also copy the app(s) to /Applications
+#
+# Needs Xcode (with the DriverKit SDK) and XcodeGen; XcodeGen is downloaded from
+# its GitHub release into .tools/ if it isn't installed.
+# The full log goes to build/build.log and, if ~/Claude exists, ~/Claude/mac-bridge-build.log.
+
+set -u
+cd "$(dirname "$0")"
+HERE=$(pwd)
+
+TEAM=""
+LITE_ONLY=0
+INSTALL=0
+XCODE=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --team) TEAM="$2"; shift ;;
+        --lite) LITE_ONLY=1 ;;
+        --install) INSTALL=1 ;;
+        --xcode) XCODE="$2"; shift ;;
+        -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
+        *) echo "unknown option $1"; exit 2 ;;
+    esac
+    shift
+done
+
+mkdir -p build
+LOG="$HERE/build/build.log"
+: > "$LOG"
+exec > >(tee -a "$LOG") 2>&1
+
+echo "== QMX Bridge build  $(date)"
+echo "   macOS $(sw_vers -productVersion) $(uname -m)"
+if [ -n "$XCODE" ]; then export DEVELOPER_DIR="$XCODE/Contents/Developer"; fi
+echo "   Xcode: $(xcode-select -p 2>/dev/null) ${DEVELOPER_DIR:+(using $DEVELOPER_DIR)}"
+xcodebuild -version || { echo "FAIL: xcodebuild not found"; exit 1; }
+xcodebuild -showsdks 2>/dev/null | grep -i driverkit || echo "note: no DriverKit SDK listed"
+
+# ---- XcodeGen
+XG=$(command -v xcodegen || true)
+if [ -z "$XG" ] && [ -x .tools/xcodegen/bin/xcodegen ]; then XG="$HERE/.tools/xcodegen/bin/xcodegen"; fi
+if [ -z "$XG" ]; then
+    echo "== downloading XcodeGen"
+    mkdir -p .tools
+    curl -fsSL -o .tools/xcodegen.zip https://github.com/yonaskolb/XcodeGen/releases/latest/download/xcodegen.zip \
+        && (cd .tools && unzip -oq xcodegen.zip) && XG="$HERE/.tools/xcodegen/bin/xcodegen"
+    [ -x "$XG" ] || { echo "FAIL: couldn't get XcodeGen (brew install xcodegen)"; exit 1; }
+fi
+echo "== $("$XG" --version 2>/dev/null)"
+"$XG" generate --spec project.yml || { echo "FAIL: xcodegen"; exit 1; }
+
+# ---- signing
+if [ -n "$TEAM" ]; then
+    SIGN=(DEVELOPMENT_TEAM="$TEAM" CODE_SIGN_STYLE=Automatic -allowProvisioningUpdates)
+    echo "== signing with team $TEAM"
+else
+    # Xcode won't sign DriverKit/system-extension entitlements without a provisioning
+    # profile, so build unsigned and sign ad-hoc with the entitlements afterwards.
+    SIGN=(CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY= DEVELOPMENT_TEAM=)
+    echo "== building unsigned, then signing to run locally (ad-hoc)"
+fi
+
+OK=1
+build() {   # scheme
+    echo "== xcodebuild $1"
+    xcodebuild -project QMXBridge.xcodeproj -scheme "$1" -configuration Release \
+        -derivedDataPath build/dd "${SIGN[@]}" build
+    local rc=$?
+    if [ $rc -ne 0 ]; then echo "FAIL: $1 (exit $rc)"; OK=0; else echo "ok  : $1"; fi
+}
+
+build QMXBridgeLite
+[ $LITE_ONLY -eq 1 ] || build QMXBridge
+
+PROD=build/dd/Build/Products/Release
+adhoc() {   # bundle entitlements
+    codesign --force --sign - --timestamp=none ${2:+--entitlements "$2"} "$1" && echo "signed (ad-hoc): $1"
+}
+if [ -z "$TEAM" ]; then
+    for d in "$PROD/QMX Bridge.app/Contents/Library/SystemExtensions"/*.dext; do
+        [ -d "$d" ] && adhoc "$d" QMXSerialDriver/QMXSerialDriver.entitlements
+    done
+    [ -d "$PROD/QMX Bridge.app" ] && adhoc "$PROD/QMX Bridge.app" QMXBridge/QMXBridge.entitlements
+    [ -d "$PROD/QMX Bridge Lite.app" ] && adhoc "$PROD/QMX Bridge Lite.app"
+fi
+mkdir -p build/out
+rm -rf build/out/*.app
+for app in "QMX Bridge Lite.app" "QMX Bridge.app"; do
+    if [ -d "$PROD/$app" ] && [ -x "$PROD/$app/Contents/MacOS/${app%.app}" ]; then
+        rm -rf "build/out/$app"; cp -R "$PROD/$app" build/out/
+        echo "built: build/out/$app"
+        codesign -dv --entitlements - "build/out/$app" 2>&1 | sed 's/^/      /' | head -30
+        if [ -d "build/out/$app/Contents/Library/SystemExtensions" ]; then
+            ls "build/out/$app/Contents/Library/SystemExtensions"
+            for d in "build/out/$app/Contents/Library/SystemExtensions"/*.dext; do
+                codesign -dv --entitlements - "$d" 2>&1 | sed 's/^/      /' | head -30
+            done
+        fi
+        if [ $INSTALL -eq 1 ]; then
+            rm -rf "/Applications/$app" && cp -R "build/out/$app" /Applications/ && echo "installed: /Applications/$app"
+        fi
+    fi
+done
+
+echo
+echo "== errors:"
+grep -E "error:|\*\* BUILD FAILED" "$LOG" | sort -u | head -60 || true
+echo "== RESULT: $([ $OK -eq 1 ] && echo BUILD OK || echo BUILD FAILED)"
+if [ -d "$HOME/Claude" ]; then cp "$LOG" "$HOME/Claude/mac-bridge-build.log"; fi
+[ $OK -eq 1 ]
diff --git a/tools/mac-bridge-app/project.yml b/tools/mac-bridge-app/project.yml
new file mode 100644
index 00000000..1168c981
--- /dev/null
+++ b/tools/mac-bridge-app/project.yml
@@ -0,0 +1,108 @@
+# XcodeGen spec for QMX Bridge (run ./build.sh, or `xcodegen` then open QMXBridge.xcodeproj).
+#
+#   QMX Bridge.app       - the app, with the virtual USB serial port driver embedded
+#   QMXSerialDriver.dext - DriverKit IOUserSerial driver (Contents/Library/SystemExtensions)
+#   QMX Bridge Lite.app  - the same app without the driver (pseudo-terminal serial port only;
+#                          no special entitlements, builds and runs anywhere)
+
+name: QMXBridge
+options:
+  bundleIdPrefix: com.qmx.panadapter
+  deploymentTarget:
+    macOS: "14.0"
+  createIntermediateGroups: true
+
+settings:
+  base:
+    SWIFT_VERSION: "5.0"
+    MARKETING_VERSION: "1.0"
+    CURRENT_PROJECT_VERSION: "1"
+    CODE_SIGN_STYLE: Automatic
+    DEAD_CODE_STRIPPING: YES
+
+targetTemplates:
+  BridgeApp:
+    type: application
+    platform: macOS
+    sources:
+      - path: QMXBridge
+        excludes: ["*.entitlements"]
+      - path: Shared
+    settings:
+      base:
+        SWIFT_OBJC_BRIDGING_HEADER: QMXBridge/QMXBridge-Bridging-Header.h
+        ENABLE_HARDENED_RUNTIME: YES
+        GENERATE_INFOPLIST_FILE: YES
+        INFOPLIST_KEY_CFBundleDisplayName: QMX Bridge
+        INFOPLIST_KEY_LSApplicationCategoryType: public.app-category.utilities
+        INFOPLIST_KEY_NSHumanReadableCopyright: QMX-Panadapter-NAS
+        INFOPLIST_KEY_NSLocalNetworkUsageDescription: QMX Bridge finds the QMX relay on your NAS and connects to it over the local network.
+        COMBINE_HIDPI_IMAGES: YES
+
+targets:
+  QMXBridge:
+    templates: [BridgeApp]
+    settings:
+      base:
+        PRODUCT_NAME: QMX Bridge
+        PRODUCT_BUNDLE_IDENTIFIER: com.qmx.panadapter.bridge
+        CODE_SIGN_ENTITLEMENTS: QMXBridge/QMXBridge.entitlements
+    dependencies:
+      - target: QMXSerialDriver
+        embed: true
+        codeSign: true
+        copy:
+          destination: wrapper
+          subpath: Contents/Library/SystemExtensions
+
+  QMXBridgeLite:
+    templates: [BridgeApp]
+    settings:
+      base:
+        PRODUCT_NAME: QMX Bridge Lite
+        PRODUCT_BUNDLE_IDENTIFIER: com.qmx.panadapter.bridge.lite
+        CODE_SIGN_ENTITLEMENTS: QMXBridge/QMXBridgeLite.entitlements
+        SWIFT_ACTIVE_COMPILATION_CONDITIONS: "$(inherited) QMX_LITE"
+
+  QMXSerialDriver:
+    type: driver-extension
+    platform: macOS
+    sources:
+      - path: QMXSerialDriver/QMXSerialDriver.iig
+        buildPhase: sources
+      - path: QMXSerialDriver/QMXBridgeControl.iig
+        buildPhase: sources
+      - path: QMXSerialDriver/QMXBridgeUserClient.iig
+        buildPhase: sources
+      - path: QMXSerialDriver/QMXSerialDriver.cpp
+      - path: QMXSerialDriver/QMXBridgeControl.cpp
+      - path: QMXSerialDriver/QMXBridgeUserClient.cpp
+      - path: QMXSerialDriver/Info.plist
+        buildPhase: none
+      - path: Shared/QMXBridgeShared.h
+        buildPhase: none
+    settings:
+      base:
+        SDKROOT: driverkit
+        SUPPORTED_PLATFORMS: driverkit
+        DRIVERKIT_DEPLOYMENT_TARGET: "23.0"
+        PRODUCT_NAME: QMXSerialDriver
+        PRODUCT_BUNDLE_IDENTIFIER: com.qmx.panadapter.bridge.serialdriver
+        INFOPLIST_FILE: QMXSerialDriver/Info.plist
+        GENERATE_INFOPLIST_FILE: NO
+        CODE_SIGN_ENTITLEMENTS: QMXSerialDriver/QMXSerialDriver.entitlements
+        OTHER_LDFLAGS: "-framework DriverKit -framework SerialDriverKit"
+        CLANG_CXX_LANGUAGE_STANDARD: "gnu++17"
+        ENABLE_HARDENED_RUNTIME: NO
+        INSTALL_PATH: /Library/DriverExtensions
+
+schemes:
+  QMXBridge:
+    build:
+      targets:
+        QMXBridge: all
+        QMXSerialDriver: all
+  QMXBridgeLite:
+    build:
+      targets:
+        QMXBridgeLite: all
-- 
