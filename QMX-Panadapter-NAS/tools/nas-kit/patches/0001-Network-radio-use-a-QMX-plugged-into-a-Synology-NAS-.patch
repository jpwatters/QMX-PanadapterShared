 }
 
+// GET  /api/relay -> {"host","port","enabled","connected","transport","iq_pairs","last_error"}
+// POST /api/relay  {"host":"192.168.1.20","port":7355}  (host "" = back to USB)
+// Network radio: the QMX plugged into a NAS running tools/nas-relay. Applies
+// immediately: persists, retargets, and drops the current link so cat.c's
+// link_task reconnects over the newly selected transport.
+static esp_err_t relay_get_handler(httpd_req_t *req)
+{
+    char host[RADIO_RELAY_HOST_LEN];
+    uint16_t port;
+    radio_relay_get_target(host, sizeof(host), &port);
+    cJSON *root = cJSON_CreateObject();
+    if (!root) return httpd_resp_send_500(req);
+    cJSON_AddStringToObject(root, "host", host);
+    cJSON_AddNumberToObject(root, "port", port);
+    cJSON_AddBoolToObject(root, "enabled", radio_relay_enabled());
+    cJSON_AddBoolToObject(root, "connected", radio_relay_connected());
+    cJSON_AddStringToObject(root, "transport", cat_get_transport());
+    cJSON_AddNumberToObject(root, "iq_pairs", (double)radio_relay_iq_pairs_total());
+    cJSON_AddStringToObject(root, "last_error", radio_relay_last_error());
+    char *out = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!out) return httpd_resp_send_500(req);
+    httpd_resp_set_type(req, "application/json");
+    esp_err_t err = httpd_resp_sendstr(req, out);
+    cJSON_free(out);
+    return err;
+}
+
+static esp_err_t relay_post_handler(httpd_req_t *req)
+{
+    char buf[160];
+    int len = httpd_req_recv(req, buf, sizeof(buf) - 1);
+    if (len < 0) {
+        httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "no body");
+        return ESP_FAIL;
+    }
+    buf[len] = '\0';
+    cJSON *root = cJSON_Parse(buf);
+    if (!root) {
+        httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "bad json");
+        return ESP_FAIL;
+    }
+    const char *host = cJSON_GetStringValue(cJSON_GetObjectItem(root, "host"));
+    cJSON *jp = cJSON_GetObjectItem(root, "port");
+    int port = cJSON_IsNumber(jp) ? jp->valueint : RADIO_RELAY_DEFAULT_PORT;
+    if (port <= 0 || port > 65535 || (host && strlen(host) >= RADIO_RELAY_HOST_LEN)) {
+        cJSON_Delete(root);
+        httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "bad host/port");
+        return ESP_FAIL;
+    }
+    settings_set_relay(host ? host : "", (uint16_t)port);
+    radio_relay_set_target(host ? host : "", (uint16_t)port);
+    cJSON_Delete(root);
+    cat_reconnect();
+    return relay_get_handler(req);
+}
+
+static const httpd_uri_t uri_relay_get = {
+    .uri = "/api/relay", .method = HTTP_GET, .handler = relay_get_handler,
+};
+static const httpd_uri_t uri_relay_post = {
+    .uri = "/api/relay", .method = HTTP_POST, .handler = relay_post_handler,
+};
+
 static const httpd_uri_t uri_eqsl_creds = {
     .uri = "/api/eqsl_creds", .method = HTTP_POST, .handler = eqsl_creds_handler,
 };
@@ -9556,6 +9622,8 @@ esp_err_t webserver_start(void)
     reg(&uri_help);
     reg(&uri_manual);
     reg(&uri_eqsl_creds);
+    reg(&uri_relay_get);    // network radio (QMX on a NAS)
+    reg(&uri_relay_post);
     reg(&uri_qrz_lookup_creds);
     reg(&uri_eqsl_upload);
     reg(&uri_cloudlog_creds);
