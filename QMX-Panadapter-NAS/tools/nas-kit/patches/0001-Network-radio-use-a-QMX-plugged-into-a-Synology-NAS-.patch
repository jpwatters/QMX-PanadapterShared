+// Network radio source (net/radio_relay.c): the same post-decode path as
+// process_rx(), minus the 24-bit unpack the NAS relay already did.
+void audio_push_net_iq(const int16_t *iq, size_t pairs)
+{
+    static int16_t buf[2048 * 2];
+    if (!s_ring || !iq || pairs == 0) return;
+
+    if (s_flat_reset_pending) {
+        s_flat_reset_pending = false;
+        ui_flat_mode_reset();
+    }
+
+    int16_t local_peak_L = s_peak_left;
+    int16_t local_peak_R = s_peak_right;
+    while (pairs) {
+        size_t n = pairs > 2048 ? 2048 : pairs;
+        for (size_t i = 0; i < n; i++) {
+            int16_t Is = iq[2*i];
+            int16_t Qs = iq[2*i + 1];
+            int16_t aL = (Is < 0) ? (int16_t)(Is == -32768 ? 32767 : -Is) : Is;
+            int16_t aR = (Qs < 0) ? (int16_t)(Qs == -32768 ? 32767 : -Qs) : Qs;
+            if (aL > local_peak_L) local_peak_L = aL;
+            if (aR > local_peak_R) local_peak_R = aR;
+            iq_balance_apply(&Is, &Qs);
+            buf[2*i]     = Is;
+            buf[2*i + 1] = Qs;
+        }
+        s_samples_this_period += n;
+        if (xRingbufferSend(s_ring, buf, n * sizeof(int16_t) * 2, 0) == pdTRUE) {
+            s_pairs_written += n;
+        } else {
+            s_dropped_this_period += n;
+            s_dropped_total += n;
+        }
+        dsp_rxaudio_forward(buf, n);   // RX audio demodulator, as process_rx() does
+        iq += 2 * n;
+        pairs -= n;
+    }
+    s_peak_left = local_peak_L;
+    s_peak_right = local_peak_R;
+}
